+static gboolean sink_has_port(const pa_sink_info *sink, const gchar *name)
+{
+    guint i;
+
+    if (!name)
+        return FALSE;
+
+    for (i = 0; i < sink->n_ports; i++) {
+        if (g_strcmp0(sink->ports[i]->name, name) == 0)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+/*
+ * With PipeWire's (and PulseAudio >= 15) UCM support, every UCM device gets a
+ * sink of its own, and devices sharing a PCM end up in separate profiles: the
+ * speaker is then not a port of the earpiece sink but part of another profile
+ * of the same verb. Switch to the best available one with (or without) it.
+ */
+static void select_speaker_profile(pa_context *ctx, const pa_card_info *info, int eol, void *data)
+{
+    CadPulseOperation *operation = data;
+    pa_card_profile_info2 *profile, *target = NULL;
+    pa_operation *op = NULL;
+    gboolean want_speaker = !!operation->value;
+    g_autofree gchar *prefix = NULL;
+    const gchar *paren;
+    guint i;
+
+    if (eol != 0)
+        return;
+
+    if (!info) {
+        g_critical("PA returned no card info (eol=%d)", eol);
+        operation_complete_cb(ctx, 0, operation);
+        return;
+    }
+
+    if (info->index != operation->pulse->card_id)
+        return;
+
+    /*
+     * At the end of a call the speaker is turned off together with the
+     * switch back to the default mode, both from the same card state: leave
+     * the profile to the mode switch, or the stale voice profile wins.
+     */
+    if (operation->pulse->requested_mode == CALL_AUDIO_MODE_DEFAULT) {
+        g_debug("leaving the profile to the mode switch");
+        operation_complete_cb(ctx, 1, operation);
+        return;
+    }
+
+    profile = info->active_profile2;
+    paren = profile ? strstr(profile->name, " (") : NULL;
+    if (!paren) {
+        g_warning("active profile '%s' has no device list", profile ? profile->name : "(null)");
+        operation_complete_cb(ctx, 0, operation);
+        return;
+    }
+    prefix = g_strndup(profile->name, paren - profile->name + 2);
+
+    for (i = 0; i < info->n_profiles; i++) {
+        profile = info->profiles2[i];
+
+        if (!profile->available || !g_str_has_prefix(profile->name, prefix))
+            continue;
+        if ((strstr(profile->name, "Speaker") != NULL) != want_speaker)
+            continue;
+        if (!target || profile->priority > target->priority)
+            target = profile;
+    }
+
+    if (target && g_strcmp0(target->name, info->active_profile2->name) != 0) {
+        g_debug("switching to profile '%s' for speaker %s", target->name,
+                want_speaker ? "on" : "off");
+        op = pa_context_set_card_profile_by_index(ctx, operation->pulse->card_id,
+                                                  target->name,
+                                                  operation_complete_cb, operation);
+    }
+
+    if (op) {
+        pa_operation_unref(op);
+    } else {
+        g_warning("no profile %s speaker found", want_speaker ? "with" : "without");
+        operation_complete_cb(ctx, 0, operation);
+    }
+}
