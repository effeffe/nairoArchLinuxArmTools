# nairo bring-up additions on top of arm64 defconfig
CONFIG_FB=y
# Bootloader splash framebuffer as a DRM device (Wayland compositors need DRM);
# fbcon keeps working through DRM fbdev emulation. simplefb would grab the
# same simple-framebuffer node, so it is off.
# CONFIG_FB_SIMPLE is not set
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_POWER_RESET_QCOM_PON=y
# Motorola ABL does not start an Image with the EFI stub (MZ header)
# CONFIG_EFI is not set
CONFIG_PINCTRL_SM7250=y
# 48-bit VA like the Motorola Edge 30 mainline port (no LPA2 on Kryo 475)
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
# CONFIG_ARM64_LPA2 is not set
# USB 2.0 device mode (gadget networking), built in: no modules in the initramfs
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# UFS storage
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# CONFIG_SCSI_UFS_CRYPTO is not set
CONFIG_EXFAT_FS=y
# Arch userspace: pacman 7 download sandbox (Landlock)
CONFIG_SECURITY_LANDLOCK=y
# PMIC ADC (battery/system voltage, charger and die temperatures) and thermal alarms
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
# Novatek NT36672C touch (bring-up driver imported from sm8150-mainline), module
CONFIG_TOUCHSCREEN_NT36XXX_SPI=m
# PM7250B SMB5 charger (qcom_smbx + SMB5 v4 series), module loaded by hand
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_BATTERY_QCOM_QG=m
CONFIG_SM_GPUCC_8250=y
# Display backlight (PM8150L WLED)
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
# Strips the CPU side of imported sg tables; msm maps imports from it
# CONFIG_DMABUF_DEBUG is not set
# Waydroid: PSI for Android's lmkd, NAT for the container network (binder below)
CONFIG_PSI=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NF_CT_NETLINK=m
# zram swap (zram-generator); zstd by default, lz4 available for speed
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# Waydroid binder: this tree only has the Rust binder (includes binderfs)
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
# Stable release name across commits (modules, DKMS); build with LOCALVERSION= set
CONFIG_LOCALVERSION="-nairo"
# CONFIG_LOCALVERSION_AUTO is not set
# Rust: with SCHEDSTATS off, struct sched_statistics is empty but cacheline
# aligned; bindgen drops that alignment and every task_struct field after
# "stats" is 40 bytes off in the Rust bindings (rust_binder mmap -EINVAL)
CONFIG_SCHEDSTATS=y
