From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:59 +0100
Subject: [PATCH 157/159] arm64: dts: qcom: nairo: Add loudspeaker amplifier

Add the AW882xx loudspeaker amplifier on I2C9 at 0x34 (reset GPIO 90),
with its register table, on secondary MI2S: data on SD1 as downstream
(qcom,msm-mi2s-rx-lines), pins GPIO 70/71/72/74.

Add a MultiMedia3 front end for it.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 .../boot/dts/qcom/sm7250-motorola-nairo.dts   | 56 +++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
index 0ce3bb917dff..f10aee246bb8 100644
--- a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
+++ b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
@@ -599,6 +599,14 @@ &pon_resin {
 	status = "okay";
 };
 
+&q6afedai {
+	/* playback on SD1, as downstream (qcom,msm-mi2s-rx-lines = <2>) */
+	dai@18 {
+		reg = <SECONDARY_MI2S_RX>;
+		qcom,sd-lines = <1>;
+	};
+};
+
 &q6asmdai {
 	/* a front end uses one DSP session for both directions: split them */
 	dai@0 {
@@ -610,6 +618,11 @@ dai@1 {
 		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
 		direction = <Q6ASM_DAI_TX>;
 	};
+
+	dai@2 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
+		direction = <Q6ASM_DAI_RX>;
+	};
 };
 
 &remoteproc_adsp {
@@ -638,6 +651,8 @@ &rxmacro {
 &sound {
 	compatible = "qcom,sm8250-sndcard";
 	model = "Motorola Moto G 5G Plus";
+	pinctrl-0 = <&sec_mi2s_active>;
+	pinctrl-names = "default";
 	audio-routing =
 		"IN1_HPHL", "HPHL_OUT",
 		"IN2_HPHR", "HPHR_OUT",
@@ -666,6 +681,14 @@ cpu {
 		};
 	};
 
+	mm3-dai-link {
+		link-name = "MultiMedia3";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+		};
+	};
+
 	wcd-playback-dai-link {
 		link-name = "WCD Playback";
 
@@ -682,6 +705,22 @@ platform {
 		};
 	};
 
+	speaker-dai-link {
+		link-name = "Speaker Playback";
+
+		cpu {
+			sound-dai = <&q6afedai SECONDARY_MI2S_RX>;
+		};
+
+		codec {
+			sound-dai = <&speaker_amp>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
 	wcd-capture-dai-link {
 		link-name = "WCD Capture";
 
@@ -752,6 +791,16 @@ haptics@5a {
 		awinic,cont-td = <0x6c>;
 		awinic,cont-zc-threshold = <0xff1>;
 	};
+
+	/* speaker amplifier on secondary MI2S */
+	speaker_amp: audio-amplifier@34 {
+		compatible = "awinic,aw882xx";
+		reg = <0x34>;
+		reset-gpios = <&tlmm 90 GPIO_ACTIVE_LOW>;
+		firmware-name = "qcom/sm7250/motorola/nairo/aw882xx_spk_reg.bin";
+		sound-name-prefix = "Speaker";
+		#sound-dai-cells = <0>;
+	};
 };
 
 &spi7 {
@@ -810,6 +859,13 @@ google_key_n: google-key-n-state {
 		bias-pull-up;
 	};
 
+	sec_mi2s_active: sec-mi2s-active-state {
+		pins = "gpio70", "gpio71", "gpio72", "gpio74";
+		function = "sec_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
 	wcd938x_reset_default: wcd938x-reset-default-state {
 		pins = "gpio57";
 		function = "gpio";
