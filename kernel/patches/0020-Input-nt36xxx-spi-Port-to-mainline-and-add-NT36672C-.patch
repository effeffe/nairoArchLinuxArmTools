 static size_t fw_need_write_size = 0;
+
+/*
+ * The image ends at the 4 KiB sector carrying an "NVT" or "MOD" end flag; the
+ * file itself can be longer (e.g. the Motorola NT36672C image). From Motorola's
+ * nova_0flash_mmi driver.
+ */
+static int32_t nvt_get_fw_need_write_size(const struct firmware *fw_entry)
+{
+	int32_t i;
+
+	for (i = fw_entry->size / FLASH_SECTOR_SIZE; i > 0; i--) {
+		const u8 *flag = &fw_entry->data[i * FLASH_SECTOR_SIZE - NVT_FLASH_END_FLAG_LEN];
+
+		if (!memcmp(flag, "NVT", NVT_FLASH_END_FLAG_LEN) ||
+		    !memcmp(flag, "MOD", NVT_FLASH_END_FLAG_LEN)) {
+			fw_need_write_size = i * FLASH_SECTOR_SIZE;
+			NVT_LOG("fw_need_write_size = %zu(0x%zx)\n",
+				fw_need_write_size, fw_need_write_size);
+			return 0;
+		}
+	}
+
+	NVT_ERR("end flag \"NVT\" \"MOD\" not found!\n");
+	return -1;
+}
