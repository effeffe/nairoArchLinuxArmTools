From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:59 +0100
Subject: [PATCH 155/159] arm64: dts: qcom: nairo: Add AW8695 haptics

Add the AW8695 LRA driver on I2C9 at 0x5a, with its reset GPIO 65 and
the tuning values of the downstream device tree (f0 235.0 Hz).

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 .../boot/dts/qcom/sm7250-motorola-nairo.dts   | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
index 78b23ac7e399..fc9e1fa6bc8e 100644
--- a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
+++ b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
@@ -596,6 +596,28 @@ &sdhc_2 {
 	status = "okay";
 };
 
+&i2c9 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	/* LRA vibration motor driver; tuning values from the downstream DT */
+	haptics@5a {
+		compatible = "awinic,aw8695";
+		reg = <0x5a>;
+		reset-gpios = <&tlmm 65 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&haptics_reset_n>;
+		pinctrl-names = "default";
+
+		awinic,f0-decihertz = <2350>;
+		awinic,cont-drive-level = <0x6e>;
+		awinic,cont-overdrive-level = <0x78>;
+		awinic,cont-brake-cycles = <3>;
+		awinic,cont-td = <0x6c>;
+		awinic,cont-zc-threshold = <0xff1>;
+	};
+};
+
 &spi7 {
 	status = "okay";
 
@@ -651,6 +673,13 @@ google_key_n: google-key-n-state {
 		drive-strength = <2>;
 		bias-pull-up;
 	};
+
+	haptics_reset_n: haptics-reset-n-state {
+		pins = "gpio65";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
 };
 
 &ufs_mem_hc {
