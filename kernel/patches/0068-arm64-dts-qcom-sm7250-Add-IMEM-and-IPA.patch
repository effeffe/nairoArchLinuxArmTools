From 3f0138f3b73d9827da3769ffdbfd88ef57338c25 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Wed, 7 Oct 2026 16:50:50 +0100
Subject: [PATCH 68/69] arm64: dts: qcom: sm7250: Add IMEM and IPA

Describe the part of IMEM that holds the IPA modem tables (0x146a9000),
the restart reason the bootloader reads (offset 0x265c, values from the
downstream kernel) and the PIL relocation info, and add the IPA v4.7
node: same register layout and interrupts as SM6350, SMMU stream IDs
0x520/0x522 from downstream, the IPA smp2p entries and the ipa-fw
region already in this file.

The node has no interconnects because SM7250 has no interconnect
provider yet; the IPA driver then simply skips its bandwidth votes.

The reboot-mode values alone do not make "reboot bootloader" work on the
Motorola board, which also needs a PMIC flag and a hard reset.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 66 ++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index 353f96e7a..caf2c5394 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -706,6 +706,43 @@ ufs_mem_phy: phy@1d87000 {
 			status = "disabled";
 		};
 
+		ipa: ipa@1e40000 {
+			compatible = "qcom,sm7250-ipa";
+
+			iommus = <&apps_smmu 0x520 0x0>,
+				 <&apps_smmu 0x522 0x0>;
+			reg = <0x0 0x01e40000 0x0 0x8000>,
+			      <0x0 0x01e50000 0x0 0x3000>,
+			      <0x0 0x01e04000 0x0 0x23000>;
+			reg-names = "ipa-reg",
+				    "ipa-shared",
+				    "gsi";
+
+			interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING>,
+					      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
+					      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+					      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "ipa",
+					  "gsi",
+					  "ipa-clock-query",
+					  "ipa-setup-ready";
+
+			clocks = <&rpmhcc RPMH_IPA_CLK>;
+			clock-names = "core";
+
+			qcom,smem-states = <&ipa_smp2p_out 0>,
+					   <&ipa_smp2p_out 1>;
+			qcom,smem-state-names = "ipa-clock-enabled-valid",
+						"ipa-clock-enabled";
+
+			qcom,gsi-loader = "self";
+			memory-region = <&ipa_fw_mem>;
+
+			sram = <&ipa_modem_tables>;
+
+			status = "disabled";
+		};
+
 		gpu: gpu@3d00000 {
 			compatible = "qcom,adreno-620.0", "qcom,adreno";
 			reg = <0x0 0x03d00000 0x0 0x40000>;
@@ -982,6 +1019,35 @@ usb_1: usb@a600000 {
 			status = "disabled";
 		};
 
+		sram@146a9000 {
+			compatible = "qcom,sm7250-imem", "syscon", "simple-mfd";
+			reg = <0x0 0x146a9000 0x0 0x3000>;
+			ranges = <0 0 0x146a9000 0x3000>;
+
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			ipa_modem_tables: modem-tables@0 {
+				reg = <0x0 0x2000>;
+			};
+
+			/*
+			 * The bootloader reads the restart reason the downstream
+			 * kernel writes here, in addition to the PMIC PON one.
+			 */
+			reboot-mode {
+				compatible = "syscon-reboot-mode";
+				offset = <0x265c>;
+				mode-bootloader = <0x77665500>;
+				mode-recovery = <0x77665502>;
+			};
+
+			pil-reloc@294c {
+				compatible = "qcom,pil-reloc-info";
+				reg = <0x294c 0xc8>;
+			};
+		};
+
 		apps_smmu: iommu@15000000 {
 			compatible = "qcom,sm7250-smmu-500", "qcom,smmu-500", "arm,mmu-500";
 			reg = <0x0 0x15000000 0x0 0x100000>;
-- 
