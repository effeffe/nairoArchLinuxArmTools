index 000000000000..46c0d6c62008
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/qcom,pm8150l-lcdb.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/qcom,pm8150l-lcdb.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PMIC LCD bias (LCDB) regulators
+
+maintainers:
+  - Filippo Falezza <filippo.falezza@outlook.it>
+
+description:
+  The LCDB block generates the positive (LDO) and negative (NCP) bias
+  supplies of LCD panels from a common boost stage. The two outputs have
+  their own voltage but a single enable.
+
+properties:
+  compatible:
+    const: qcom,pm8150l-lcdb
+
+  ldo:
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description: Positive bias output
+
+  ncp:
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description: Negative bias output (the voltage is its magnitude)
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+        lcdb {
+            compatible = "qcom,pm8150l-lcdb";
+
+            ldo {
+                regulator-min-microvolt = <5500000>;
+                regulator-max-microvolt = <5500000>;
+            };
+
+            ncp {
+                regulator-min-microvolt = <5500000>;
+                regulator-max-microvolt = <5500000>;
+            };
+        };
+    };
+...
