From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sat, 10 Oct 2026 23:13:22 +0100
Subject: [PATCH 090/113] arm64: dts: qcom: sm7250: Add the display clock
 controller

SM7250 has no MMCX rail: the display clock controller is supplied by
CX, as in the downstream device tree. The DSI and DP PHY inputs are
left empty until those PHYs are described.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index f2dbd1e35..62bf5ff16 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -3,6 +3,7 @@
  * Copyright (c) 2026, Sreeshankar K <sreeshankar0910@gmail.com>
  */
 
+#include <dt-bindings/clock/qcom,dispcc-sm8250.h>
 #include <dt-bindings/clock/qcom,gpucc-sm8250.h>
 #include <dt-bindings/clock/qcom,rpmh.h>
 #include <dt-bindings/clock/qcom,sm7250-gcc.h>
@@ -1478,6 +1479,28 @@ intc: interrupt-controller@17a00000 {
 			interrupts = <GIC_PPI 8 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		dispcc: clock-controller@af00000 {
+			compatible = "qcom,sm7250-dispcc";
+			reg = <0x0 0x0af00000 0x0 0x20000>;
+			power-domains = <&rpmhpd RPMHPD_CX>;
+			required-opps = <&rpmhpd_opp_low_svs>;
+			/* DSI and DP PHYs are added with the display */
+			clocks = <&rpmhcc RPMH_CXO_CLK>,
+				 <&gcc GCC_DISP_GPLL0_CLK_SRC>,
+				 <0>, <0>, <0>, <0>, <0>, <0>;
+			clock-names = "bi_tcxo",
+				      "gcc_disp_gpll0_clk_src",
+				      "dsi0_phy_pll_out_byteclk",
+				      "dsi0_phy_pll_out_dsiclk",
+				      "dsi1_phy_pll_out_byteclk",
+				      "dsi1_phy_pll_out_dsiclk",
+				      "dp_phy_pll_link_clk",
+				      "dp_phy_pll_vco_div_clk";
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+			#power-domain-cells = <1>;
+		};
+
 		pdc: interrupt-controller@b220000 {
 			compatible = "qcom,sm7250-pdc", "qcom,pdc";
 			reg = <0 0xb220000 0 0x30000>, <0 0x17c000f0 0 0x60>;
