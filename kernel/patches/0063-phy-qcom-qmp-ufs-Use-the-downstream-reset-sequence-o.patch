From a62e17c00434b250fb6a39cc82feaacd9e4e0490 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Wed, 7 Oct 2026 13:33:09 +0100
Subject: [PATCH 63/69] phy: qcom: qmp-ufs: Use the downstream reset sequence
 on SM7250

Downstream (phy-qcom-ufs-qmp-v4-lito.c) asserts the PCS SW_RESET before
writing the tables and waits up to 1 s for PCS_READY. Do the same for
SM7250: the PHY is otherwise programmed straight out of whatever state
the previous session left, and the 10 ms limit was too short for PLL
re-lock after a runtime host reset.

Also log when PCS_READY takes longer than the default timeout, and on a
timeout dump the PCS control and SerDes status registers (v4/v5 COM
layout, SM7250 only); this is what showed the PLL failing to lock.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/phy/qualcomm/phy-qcom-qmp-ufs.c | 29 ++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
index f73221370..aa91013f0 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
@@ -10,6 +10,7 @@
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
+#include <linux/ktime.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
@@ -1192,6 +1193,10 @@ struct qmp_phy_cfg {
 
 	/* true, if PCS block has no separate SW_RESET register */
 	bool no_pcs_sw_reset;
+	/* true, if SW_RESET must be asserted before the tables are written */
+	bool pcs_sw_reset_on_init;
+	/* PCS ready timeout, PHY_INIT_COMPLETE_TIMEOUT if zero */
+	unsigned int init_timeout_us;
 };
 
 struct qmp_ufs {
@@ -1782,6 +1787,10 @@ static const struct qmp_phy_cfg sm7250_ufsphy_cfg = {
 	.vreg_list		= sm7250_ufsphy_vreg_l,
 	.num_vregs		= ARRAY_SIZE(sm7250_ufsphy_vreg_l),
 	.regs			= ufsphy_v5_regs_layout,
+
+	/* downstream: SW_RESET=1, tables, SW_RESET=0, poll up to 1 s */
+	.pcs_sw_reset_on_init	= true,
+	.init_timeout_us	= 1000000,
 };
 
 static const struct qmp_phy_cfg sm8350_ufsphy_cfg = {
@@ -2226,12 +2235,16 @@ static int qmp_ufs_phy_calibrate(struct phy *phy)
 	void __iomem *pcs = qmp->pcs;
 	void __iomem *status;
 	unsigned int val;
+	ktime_t t0;
 	int ret;
 
 	ret = reset_control_assert(qmp->ufs_reset);
 	if (ret)
 		return ret;
 
+	if (cfg->pcs_sw_reset_on_init)
+		qphy_setbits(pcs, cfg->regs[QPHY_SW_RESET], SW_RESET);
+
 	qmp_ufs_init_registers(qmp, cfg);
 
 	ret = reset_control_deassert(qmp->ufs_reset);
@@ -2246,13 +2259,27 @@ static int qmp_ufs_phy_calibrate(struct phy *phy)
 	qphy_setbits(pcs, cfg->regs[QPHY_START_CTRL], SERDES_START);
 
 	status = pcs + cfg->regs[QPHY_PCS_READY_STATUS];
+	t0 = ktime_get();
 	ret = readl_poll_timeout(status, val, (val & PCS_READY), 200,
-				 PHY_INIT_COMPLETE_TIMEOUT);
+				 cfg->init_timeout_us ?: PHY_INIT_COMPLETE_TIMEOUT);
 	if (ret) {
 		dev_err(qmp->dev, "phy initialization timed-out\n");
+		/* LOCAL debug: v4/v5 COM layout (SM7250) */
+		if (cfg->pcs_sw_reset_on_init)
+			dev_err(qmp->dev,
+				"pcs ready %#x pwrdn %#x swrst %#x start %#x com c_ready %#x cmn %#x\n",
+				readl(status),
+				readl(pcs + cfg->regs[QPHY_PCS_POWER_DOWN_CONTROL]),
+				readl(pcs + cfg->regs[QPHY_SW_RESET]),
+				readl(pcs + cfg->regs[QPHY_START_CTRL]),
+				readl(qmp->serdes + 0x178), readl(qmp->serdes + 0x140));
 		return ret;
 	}
 
+	if (ktime_us_delta(ktime_get(), t0) > PHY_INIT_COMPLETE_TIMEOUT)
+		dev_info(qmp->dev, "PCS ready after %lld us\n",
+			 ktime_us_delta(ktime_get(), t0));
+
 	return 0;
 }
 
