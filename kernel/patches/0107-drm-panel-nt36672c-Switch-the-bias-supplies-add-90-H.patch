From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 11 Oct 2026 00:35:05 +0100
Subject: [PATCH 107/116] drm/panel: nt36672c: Switch the bias supplies, add 90
 Hz

Power the panel up as downstream: vddio, then the +/-5.5 V bias with a
10 ms settle, then reset, and down in the reverse order.

Add the 90 Hz mode: the panel changes rate with the vertical front porch
at a fixed pixel clock (downstream dfps_immediate_porch_mode_vfp), 27
lines instead of 1316.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 .../gpu/drm/panel/panel-novatek-nt36672c.c    | 90 ++++++++++++++-----
 1 file changed, 68 insertions(+), 22 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36672c.c b/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
index 2b8f4462f..67c2ed947 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
@@ -30,8 +30,11 @@ struct nt36672c {
 	bool handoff;
 };
 
+/* In power-up order */
 static const struct regulator_bulk_data nt36672c_supplies[] = {
 	{ .supply = "vddio" }, /* 1.8 V */
+	{ .supply = "vsp" },   /* +5.5 V LCD bias */
+	{ .supply = "vsn" },   /* -5.5 V LCD bias */
 };
 
 static inline struct nt36672c *to_nt36672c(struct drm_panel *panel)
@@ -116,9 +119,19 @@ static int nt36672c_prepare(struct drm_panel *panel)
 	struct device *dev = &ctx->dsi->dev;
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(nt36672c_supplies), ctx->supplies);
+	/* As downstream: 1 ms after vddio, 10 ms after the bias rails */
+	ret = regulator_enable(ctx->supplies[0].consumer);
 	if (ret < 0)
 		return ret;
+	usleep_range(1000, 2000);
+
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret < 0)
+		goto err_vddio;
+	ret = regulator_enable(ctx->supplies[2].consumer);
+	if (ret < 0)
+		goto err_vsp;
+	usleep_range(10000, 11000);
 
 	/*
 	 * The bootloader leaves the panel initialized and running: keep it
@@ -131,19 +144,23 @@ static int nt36672c_prepare(struct drm_panel *panel)
 		return 0;
 	}
 
-	usleep_range(1000, 2000);
-
 	nt36672c_reset(ctx);
 
 	ret = nt36672c_on(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		regulator_bulk_disable(ARRAY_SIZE(nt36672c_supplies), ctx->supplies);
-		return ret;
+		regulator_disable(ctx->supplies[2].consumer);
+		goto err_vsp;
 	}
 
 	return 0;
+
+err_vsp:
+	regulator_disable(ctx->supplies[1].consumer);
+err_vddio:
+	regulator_disable(ctx->supplies[0].consumer);
+	return ret;
 }
 
 static int nt36672c_unprepare(struct drm_panel *panel)
@@ -157,32 +174,61 @@ static int nt36672c_unprepare(struct drm_panel *panel)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(nt36672c_supplies), ctx->supplies);
+	usleep_range(5000, 6000);
+
+	regulator_disable(ctx->supplies[2].consumer);
+	regulator_disable(ctx->supplies[1].consumer);
+	regulator_disable(ctx->supplies[0].consumer);
 
 	return 0;
 }
 
-/* 60 Hz; the panel also runs at 90 Hz with a vertical front porch of 27 */
-static const struct drm_display_mode nt36672c_tianma_mode = {
-	.clock = (1080 + 172 + 8 + 152) * (2520 + 1316 + 4 + 26) * 60 / 1000,
-	.hdisplay = 1080,
-	.hsync_start = 1080 + 172,
-	.hsync_end = 1080 + 172 + 8,
-	.htotal = 1080 + 172 + 8 + 152,
-	.vdisplay = 2520,
-	.vsync_start = 2520 + 1316,
-	.vsync_end = 2520 + 1316 + 4,
-	.vtotal = 2520 + 1316 + 4 + 26,
-	.width_mm = 67,
-	.height_mm = 157,
-	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+/*
+ * The panel changes refresh rate with the vertical front porch at a fixed
+ * pixel clock, as the downstream dfps_immediate_porch_mode_vfp: 1316 lines
+ * at 60 Hz, 27 at 90 Hz.
+ */
+#define NT36672C_MODE(fps, vfp) {					\
+	.clock = (1080 + 172 + 8 + 152) * (2520 + 1316 + 4 + 26) * 60 / 1000, \
+	.hdisplay = 1080,						\
+	.hsync_start = 1080 + 172,					\
+	.hsync_end = 1080 + 172 + 8,					\
+	.htotal = 1080 + 172 + 8 + 152,					\
+	.vdisplay = 2520,						\
+	.vsync_start = 2520 + (vfp),					\
+	.vsync_end = 2520 + (vfp) + 4,					\
+	.vtotal = 2520 + (vfp) + 4 + 26,				\
+	.width_mm = 67,							\
+	.height_mm = 157,						\
+}
+
+static const struct drm_display_mode nt36672c_tianma_modes[] = {
+	NT36672C_MODE(60, 1316),
+	NT36672C_MODE(90, 27),
 };
 
 static int nt36672c_get_modes(struct drm_panel *panel,
 			      struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector,
-						    &nt36672c_tianma_mode);
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(nt36672c_tianma_modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, &nt36672c_tianma_modes[i]);
+		if (!mode)
+			return -ENOMEM;
+
+		drm_mode_set_name(mode);
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = nt36672c_tianma_modes[0].width_mm;
+	connector->display_info.height_mm = nt36672c_tianma_modes[0].height_mm;
+
+	return ARRAY_SIZE(nt36672c_tianma_modes);
 }
 
 static const struct drm_panel_funcs nt36672c_panel_funcs = {
