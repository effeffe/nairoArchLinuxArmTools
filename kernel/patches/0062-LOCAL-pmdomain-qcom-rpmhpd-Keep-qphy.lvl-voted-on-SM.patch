From 597970e8b547baba00c941cd548e43d7ddc603e2 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Wed, 7 Oct 2026 13:33:08 +0100
Subject: [PATCH 62/69] LOCAL: pmdomain: qcom: rpmhpd: Keep qphy.lvl voted on
 SM7250

The SM7250 UFS PHY PLL needs the qphy.lvl ARC resource. Downstream votes
it (active only, level 1) whenever the PHY is powered; mainline never
does, so the rail only stays up through other subsystems' votes. Every
modem crash or restart then caused UFS lane errors (PA_ERR on both
lanes, DL replay timeouts), and the host reset that followed failed:
the SerDes PLL did not lock (COM C_READY_STATUS 0) or took up to a
second, leaving the storage dead until reboot.

Register qphy for SM7250 as an always-on domain voted at probe. With it,
five forced host resets (saved_err = CONTROLLER_FATAL_ERROR via debugfs)
re-lock the PLL within 10 ms, and 12 x 20 s of direct reads across a
modem restart, a modem crash and a Wi-Fi firmware recovery show no UFS
error at all.

LOCAL because the proper fix is to make the UFS PHY a consumer of the
qphy domain (and drop the vote when the PHY is off), as downstream does.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/pmdomain/qcom/rpmhpd.c | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
index fa8fed5bd..3b3518bf7 100644
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -41,6 +41,7 @@
  * @addr:		Resource address as looped up using resource name from
  *			cmd-db
  * @state_synced:	Indicator that sync_state has been invoked for the rpmhpd resource
+ * @always_on:		Vote the lowest enabled corner from probe and never drop it
  */
 struct rpmhpd {
 	struct device	*dev;
@@ -57,6 +58,7 @@ struct rpmhpd {
 	const char	*res_name;
 	u32		addr;
 	bool		state_synced;
+	bool		always_on;
 };
 
 struct rpmhpd_desc {
@@ -233,6 +235,17 @@ static struct rpmhpd qphy = {
 	.res_name = "qphy.lvl",
 };
 
+/*
+ * SM7250: the UFS PHY PLL needs qphy.lvl (downstream votes it whenever the
+ * PHY is powered); without an HLOS vote it depends on other subsystems' votes
+ * and fails to lock after a modem restart.
+ */
+static struct rpmhpd qphy_always_on = {
+	.pd = { .name = "qphy", },
+	.res_name = "qphy.lvl",
+	.always_on = true,
+};
+
 static struct rpmhpd gmxc = {
 	.pd = { .name = "gmxc", },
 	.res_name = "gmxc.lvl",
@@ -503,6 +516,7 @@ static struct rpmhpd *sm7250_rpmhpds[] = {
 	[RPMHPD_MSS] = &mss,
 	[RPMHPD_MX] = &mx,
 	[RPMHPD_MX_AO] = &mx_ao,
+	[RPMHPD_QPHY] = &qphy_always_on,
 };
 
 static const struct rpmhpd_desc sm7250_desc = {
@@ -1214,7 +1228,19 @@ static int rpmhpd_probe(struct platform_device *pdev)
 		rpmhpds[i]->pd.power_off = rpmhpd_power_off;
 		rpmhpds[i]->pd.power_on = rpmhpd_power_on;
 		rpmhpds[i]->pd.set_performance_state = rpmhpd_set_performance_state;
-		pm_genpd_init(&rpmhpds[i]->pd, NULL, true);
+
+		if (rpmhpds[i]->always_on) {
+			ret = rpmhpd_power_on(&rpmhpds[i]->pd);
+			if (ret)
+				return ret;
+			rpmhpds[i]->pd.flags |= GENPD_FLAG_ALWAYS_ON;
+			pm_genpd_init(&rpmhpds[i]->pd, NULL, false);
+			dev_info(dev, "%s: always on, corner %u (vlvl %u)\n",
+				 rpmhpds[i]->res_name, rpmhpds[i]->enable_corner,
+				 rpmhpds[i]->level[rpmhpds[i]->enable_corner]);
+		} else {
+			pm_genpd_init(&rpmhpds[i]->pd, NULL, true);
+		}
 
 		data->domains[i] = &rpmhpds[i]->pd;
 	}
