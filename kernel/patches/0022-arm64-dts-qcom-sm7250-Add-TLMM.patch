From 7755b521b0212dc8e72ecd4e32b98f2095714045 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 4 Oct 2026 16:28:20 +0100
Subject: [PATCH 22/69] arm64: dts: qcom: sm7250: Add TLMM

Add the pin controller node: three tiles at 0x0f100000/0x0f500000/
0x0f900000 (downstream describes one 0x0f000000 region with tile offsets),
summary interrupt SPI 208, PDC as wakeup parent, and the QUP0 SE2 UART
pin state.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index 1261ff563..4e379c9b2 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -601,6 +601,28 @@ spmi_bus: spmi@c440000 {
 			#interrupt-cells = <4>;
 		};
 
+		tlmm: pinctrl@f100000 {
+			compatible = "qcom,sm7250-tlmm";
+			reg = <0x0 0x0f100000 0x0 0x300000>,
+			      <0x0 0x0f500000 0x0 0x300000>,
+			      <0x0 0x0f900000 0x0 0x300000>;
+			reg-names = "south",
+				    "west",
+				    "east";
+			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			gpio-ranges = <&tlmm 0 0 147>; /* GPIOs + ufs_reset */
+			wakeup-parent = <&pdc>;
+
+			qup_uart2_default: qup-uart2-default-state {
+				pins = "gpio36", "gpio37";
+				function = "qup02";
+			};
+		};
+
 		apps_rsc: rsc@18200000 {
 			compatible = "qcom,rpmh-rsc";
 			reg = <0x0 0x18200000 0x0 0x10000>,
