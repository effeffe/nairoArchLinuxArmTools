From 43a99be5c73279d6956bd05410f4ae869233cd6b Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Mon, 5 Oct 2026 17:03:12 +0100
Subject: [PATCH 51/69] LOCAL: arm64: configs: nairo: UFS, backlight, zram,
 Waydroid

- UFS glue and PHY, and the WLED backlight, built in.
- The QG fuel gauge as a module.
- zram (zstd, with lz4 available) for zram-generator.
- Waydroid: the Rust binder (the only binder in this tree, with binderfs),
  PSI, conntrack netlink and nftables NAT for the container network.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 arch/arm64/configs/nairo.config | 32 ++++++++++++++++++++++++++++----
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/nairo.config b/arch/arm64/configs/nairo.config
index d1bced882..2037d8174 100644
--- a/arch/arm64/configs/nairo.config
+++ b/arch/arm64/configs/nairo.config
@@ -25,10 +25,10 @@ CONFIG_USB_GADGET=y
 CONFIG_USB_CONFIGFS=y
 CONFIG_USB_CONFIGFS_NCM=y
 CONFIG_USB_CONFIGFS_ACM=y
-# UFS storage: core built in, Qualcomm glue + PHY as modules (loaded by hand during bring-up)
-CONFIG_SCSI_UFS_QCOM=m
+# UFS storage
+CONFIG_SCSI_UFS_QCOM=y
 CONFIG_PHY_QCOM_QMP=y
-CONFIG_PHY_QCOM_QMP_UFS=m
+CONFIG_PHY_QCOM_QMP_UFS=y
 # CONFIG_SCSI_UFS_CRYPTO is not set
 CONFIG_EXFAT_FS=y
 # Arch userspace: pacman 7 download sandbox (Landlock)
@@ -41,7 +41,31 @@ CONFIG_QCOM_SPMI_TEMP_ALARM=y
 CONFIG_TOUCHSCREEN_NT36XXX_SPI=m
 # PM7250B SMB5 charger (qcom_smbx + SMB5 v4 series), module loaded by hand
 CONFIG_CHARGER_QCOM_SMB2=m
-# Adreno 620: the GPU SMMU needs its clock controller before the deferred probe timeout
+CONFIG_BATTERY_QCOM_QG=m
 CONFIG_SM_GPUCC_8250=y
+# Display backlight (PM8150L WLED)
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_BACKLIGHT_QCOM_WLED=y
 # Strips the CPU side of imported sg tables; msm maps imports from it
 # CONFIG_DMABUF_DEBUG is not set
+# Waydroid: PSI for Android's lmkd, NAT for the container network (binder below)
+CONFIG_PSI=y
+CONFIG_NF_TABLES=m
+CONFIG_NF_TABLES_INET=y
+CONFIG_NF_TABLES_IPV4=y
+CONFIG_NF_TABLES_IPV6=y
+CONFIG_NFT_CT=m
+CONFIG_NFT_NAT=m
+CONFIG_NFT_MASQ=m
+CONFIG_NFT_COMPAT=m
+CONFIG_NF_NAT=m
+CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
+CONFIG_NF_CT_NETLINK=m
+# zram swap (zram-generator); zstd by default, lz4 available for speed
+CONFIG_ZRAM=m
+CONFIG_ZRAM_BACKEND_LZ4=y
+CONFIG_ZRAM_BACKEND_ZSTD=y
+CONFIG_ZRAM_DEF_COMP_ZSTD=y
+# Waydroid binder: this tree only has the Rust binder (includes binderfs)
+CONFIG_RUST=y
+CONFIG_ANDROID_BINDER_IPC_RUST=y
-- 
