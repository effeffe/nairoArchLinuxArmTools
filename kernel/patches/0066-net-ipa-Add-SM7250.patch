From 42083766e17a768f68de361cd09917faac77f2fe Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Wed, 7 Oct 2026 16:50:50 +0100
Subject: [PATCH 66/69] net: ipa: Add SM7250

SM7250 uses the same IPA v4.7 as SM6350. Only the IMEM area holding the
modem tables differs: downstream maps 0x146a9000 for the IPA on SM7250,
0x146a8000 on SM6350. The modem allocates the same 0x9000-byte SMEM
region (downstream's qcom,ipa-q6-smem-size of 0x6800 is not what the
firmware actually uses: probing with it failed with "SMEM item has size
36864, expected 26624").

Tested on a Motorola Moto G 5G Plus: with IPA loaded before the modem
starts, the modem's IPA handshake completes and the modem, which
otherwise asserted 3 s after start ("ipa_hwp_init ... didnt rx any ind
frm HWP"), stays up.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/net/ipa/data/ipa_data-v4.7.c | 26 ++++++++++++++++++++++++++
 drivers/net/ipa/ipa_data.h           |  1 +
 drivers/net/ipa/ipa_main.c           |  4 ++++
 3 files changed, 31 insertions(+)

diff --git a/drivers/net/ipa/data/ipa_data-v4.7.c b/drivers/net/ipa/data/ipa_data-v4.7.c
index 5e1d9049c..c9f900b65 100644
--- a/drivers/net/ipa/data/ipa_data-v4.7.c
+++ b/drivers/net/ipa/data/ipa_data-v4.7.c
@@ -363,6 +363,19 @@ static const struct ipa_mem_data ipa_mem_data = {
 	.smem_size	= 0x00009000,
 };
 
+/*
+ * SM7250 has the same IPA v4.7 as SM6350, but its modem tables sit one page
+ * higher in IMEM (downstream maps 0x146a9000 for the IPA). The modem
+ * allocates the same 0x9000-byte SMEM region as on SM6350.
+ */
+static const struct ipa_mem_data ipa_mem_data_sm7250 = {
+	.local_count	= ARRAY_SIZE(ipa_mem_local_data),
+	.local		= ipa_mem_local_data,
+	.imem_addr	= 0x146a9000,
+	.imem_size	= 0x00002000,
+	.smem_size	= 0x00009000,
+};
+
 /* Interconnect rates are in 1000 byte/second units */
 static const struct ipa_interconnect_data ipa_interconnect_data[] = {
 	{
@@ -403,3 +416,16 @@ const struct ipa_data ipa_data_v4_7 = {
 	.mem_data		= &ipa_mem_data,
 	.power_data		= &ipa_power_data,
 };
+
+/* Configuration data for SM7250, an SoC having IPA v4.7 */
+const struct ipa_data ipa_data_v4_7_sm7250 = {
+	.version		= IPA_VERSION_4_7,
+	.qsb_count		= ARRAY_SIZE(ipa_qsb_data),
+	.qsb_data		= ipa_qsb_data,
+	.modem_route_count	= 8,
+	.endpoint_count		= ARRAY_SIZE(ipa_gsi_endpoint_data),
+	.endpoint_data		= ipa_gsi_endpoint_data,
+	.resource_data		= &ipa_resource_data,
+	.mem_data		= &ipa_mem_data_sm7250,
+	.power_data		= &ipa_power_data,
+};
diff --git a/drivers/net/ipa/ipa_data.h b/drivers/net/ipa/ipa_data.h
index 3eb9dc2ce..fd63b47aa 100644
--- a/drivers/net/ipa/ipa_data.h
+++ b/drivers/net/ipa/ipa_data.h
@@ -250,6 +250,7 @@ extern const struct ipa_data ipa_data_v3_5_1;
 extern const struct ipa_data ipa_data_v4_2;
 extern const struct ipa_data ipa_data_v4_5;
 extern const struct ipa_data ipa_data_v4_7;
+extern const struct ipa_data ipa_data_v4_7_sm7250;
 extern const struct ipa_data ipa_data_v4_9;
 extern const struct ipa_data ipa_data_v4_11;
 extern const struct ipa_data ipa_data_v5_0;
diff --git a/drivers/net/ipa/ipa_main.c b/drivers/net/ipa/ipa_main.c
index 14ac2d2fa..5c6a6b0dd 100644
--- a/drivers/net/ipa/ipa_main.c
+++ b/drivers/net/ipa/ipa_main.c
@@ -660,6 +660,10 @@ static const struct of_device_id ipa_match[] = {
 		.compatible	= "qcom,sm6350-ipa",
 		.data		= &ipa_data_v4_7,
 	},
+	{
+		.compatible	= "qcom,sm7250-ipa",
+		.data		= &ipa_data_v4_7_sm7250,
+	},
 	{
 		.compatible	= "qcom,sm8350-ipa",
 		.data		= &ipa_data_v4_9,
