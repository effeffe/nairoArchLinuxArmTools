From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sat, 10 Oct 2026 21:08:54 +0100
Subject: [PATCH 078/159] arm64: dts: qcom: sm7250: Add the GPU speed bin and
 its levels

Describe QFPROM with the GPU speed bin cell (bits 5-12 at 0x1ea) and
replace the two-level GPU OPP table with the downstream levels, tagged
per speed bin: 625 and 500 MHz for bins 0x00 and 0x84, 540 MHz for bin
0x73, and 400 and 275 MHz for all of them.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 40 ++++++++++++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index f3616e176323..282ab7d2f86d 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -586,6 +586,18 @@ ipcc: mailbox@408000 {
 			#mbox-cells = <2>;
 		};
 
+		qfprom: efuse@784000 {
+			compatible = "qcom,sm7250-qfprom", "qcom,qfprom";
+			reg = <0x0 0x00784000 0x0 0x8ff>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			gpu_speed_bin: gpu-speed-bin@1ea {
+				reg = <0x1ea 0x2>;
+				bits = <5 8>;
+			};
+		};
+
 		qupv3_id_1: geniqup@9c0000 {
 			compatible = "qcom,geni-se-qup";
 			reg = <0x0 0x009c0000 0x0 0x6000>;
@@ -755,6 +767,9 @@ gpu: gpu@3d00000 {
 
 			operating-points-v2 = <&gpu_opp_table>;
 
+			nvmem-cells = <&gpu_speed_bin>;
+			nvmem-cell-names = "speed_bin";
+
 			qcom,gmu = <&gmu>;
 
 			#cooling-cells = <2>;
@@ -766,20 +781,41 @@ gpu_zap_shader: zap-shader {
 			};
 
 			/*
-			 * Levels common to the downstream speed bins 0 and 0x73,
-			 * until the speed bin fuse is wired up.
+			 * From the downstream power levels. Speed bins 0x00 and 0x84
+			 * (supported-hw bits 0 and 1) run up to 625 MHz, speed bin 0x73
+			 * (bit 2) up to 540 MHz.
 			 */
 			gpu_opp_table: opp-table {
 				compatible = "operating-points-v2";
 
+				opp-625000000 {
+					opp-hz = /bits/ 64 <625000000>;
+					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
+					opp-supported-hw = <0x3>;
+				};
+
+				opp-540000000 {
+					opp-hz = /bits/ 64 <540000000>;
+					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
+					opp-supported-hw = <0x4>;
+				};
+
+				opp-500000000 {
+					opp-hz = /bits/ 64 <500000000>;
+					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
+					opp-supported-hw = <0x3>;
+				};
+
 				opp-400000000 {
 					opp-hz = /bits/ 64 <400000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
+					opp-supported-hw = <0x7>;
 				};
 
 				opp-275000000 {
 					opp-hz = /bits/ 64 <275000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
+					opp-supported-hw = <0x7>;
 				};
 			};
 		};
