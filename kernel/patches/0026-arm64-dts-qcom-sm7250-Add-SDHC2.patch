From f84c1c8faaecf46de889868fdc5cf4783ef0c31e Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 4 Oct 2026 16:28:21 +0100
Subject: [PATCH 26/69] arm64: dts: qcom: sm7250: Add SDHC2

Add the SD card controller (SPI 207/223) with its pin states. DLL/DDR
config values come from the downstream dll-hsr-list. The 64-bit DMA
capability is masked with sdhci-caps-mask since no SMMU stream ID is
described yet. Tested at UHS-I SDR104.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 94 ++++++++++++++++++++++++++++
 1 file changed, 94 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index e4aeb13b5..02408f559 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -644,6 +644,60 @@ ufs_mem_phy: phy@1d87000 {
 			status = "disabled";
 		};
 
+		sdhc_2: mmc@8804000 {
+			compatible = "qcom,sm7250-sdhci", "qcom,sdhci-msm-v5";
+			reg = <0x0 0x08804000 0x0 0x1000>;
+
+			interrupts = <GIC_SPI 207 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 223 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "hc_irq", "pwr_irq";
+
+			clocks = <&gcc GCC_SDCC2_AHB_CLK>,
+				 <&gcc GCC_SDCC2_APPS_CLK>,
+				 <&rpmhcc RPMH_CXO_CLK>;
+			clock-names = "iface", "core", "xo";
+
+			qcom,dll-config = <0x0007642c>;
+			qcom,ddr-config = <0x80040868>;
+
+			/*
+			 * No SMMU stream ID known yet, and raw DMA above 4 GiB does
+			 * not work (same as UFS): hide the 64-bit DMA capabilities.
+			 */
+			sdhci-caps-mask = <0x0 0x18000000>;
+
+			power-domains = <&rpmhpd RPMHPD_CX>;
+			operating-points-v2 = <&sdhc2_opp_table>;
+
+			bus-width = <4>;
+
+			status = "disabled";
+
+			sdhc2_opp_table: opp-table {
+				compatible = "operating-points-v2";
+
+				opp-19200000 {
+					opp-hz = /bits/ 64 <19200000>;
+					required-opps = <&rpmhpd_opp_min_svs>;
+				};
+
+				opp-50000000 {
+					opp-hz = /bits/ 64 <50000000>;
+					required-opps = <&rpmhpd_opp_low_svs>;
+				};
+
+				opp-100000000 {
+					opp-hz = /bits/ 64 <100000000>;
+					required-opps = <&rpmhpd_opp_svs>;
+				};
+
+				opp-202000000 {
+					opp-hz = /bits/ 64 <202000000>;
+					required-opps = <&rpmhpd_opp_svs_l1>;
+				};
+			};
+		};
+
 		usb_1_hsphy: phy@88e3000 {
 			compatible = "qcom,sm7250-usb-hs-phy",
 				     "qcom,usb-snps-hs-7nm-phy";
@@ -858,6 +912,46 @@ tlmm: pinctrl@f100000 {
 			gpio-ranges = <&tlmm 0 0 147>; /* GPIOs + ufs_reset */
 			wakeup-parent = <&pdc>;
 
+			sdc2_default_state: sdc2-default-state {
+				clk-pins {
+					pins = "sdc2_clk";
+					drive-strength = <16>;
+					bias-disable;
+				};
+
+				cmd-pins {
+					pins = "sdc2_cmd";
+					drive-strength = <10>;
+					bias-pull-up;
+				};
+
+				data-pins {
+					pins = "sdc2_data";
+					drive-strength = <10>;
+					bias-pull-up;
+				};
+			};
+
+			sdc2_sleep_state: sdc2-sleep-state {
+				clk-pins {
+					pins = "sdc2_clk";
+					drive-strength = <2>;
+					bias-disable;
+				};
+
+				cmd-pins {
+					pins = "sdc2_cmd";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+
+				data-pins {
+					pins = "sdc2_data";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+			};
+
 			qup_uart2_default: qup-uart2-default-state {
 				pins = "gpio36", "gpio37";
 				function = "qup02";
-- 
