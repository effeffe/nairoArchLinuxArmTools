From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:59 +0100
Subject: [PATCH 156/159] arm64: dts: qcom: nairo: Add audio

Add the WCD9380 codec (reset GPIO 57, micbiases at 2.8 V as
downstream, supplies from S4A and BOB) on the RX and TX SoundWire
buses, and the sound card: MultiMedia1 for playback, MultiMedia2 for
capture, with the WCD playback (RX_CODEC_DMA_RX_0) and capture
(TX_CODEC_DMA_TX_3) backends through the RX and TX macros.

This gives the earpiece, the headset jack and the bottom (AMIC1) and
top (AMIC3) microphones.

As a front end uses one DSP session for both directions, give each
q6asm DAI a single direction.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 .../boot/dts/qcom/sm7250-motorola-nairo.dts   | 147 ++++++++++++++++++
 1 file changed, 147 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
index fc9e1fa6bc8e..0ce3bb917dff 100644
--- a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
+++ b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
@@ -14,6 +14,7 @@
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
 
 #include "sm7250.dtsi"
 #include "pm8150.dtsi"
@@ -37,6 +38,33 @@ / {
 	qcom,msm-id = <QCOM_ID_SM7250 0x10000>, <440 0x10000>;
 	qcom,board-id = <0 0>;
 
+	/* WCD9380 codec: earpiece, headset jack and the analog microphones */
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9380-codec";
+
+		reset-gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&wcd938x_reset_default>;
+		pinctrl-names = "default";
+
+		vdd-buck-supply = <&vreg_s4a_1p8>;
+		vdd-rxtx-supply = <&vreg_s4a_1p8>;
+		vdd-io-supply = <&vreg_s4a_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		/* downstream qcom,cdc-micbiasN-mv */
+		qcom,micbias1-microvolt = <2800000>;
+		qcom,micbias2-microvolt = <2800000>;
+		qcom,micbias3-microvolt = <2800000>;
+		qcom,micbias4-microvolt = <2800000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
 	chosen {
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -368,6 +396,13 @@ regulators-1 {
 		compatible = "qcom,pm8150l-rpmh-regulators";
 		qcom,pmic-id = "c";
 
+		vreg_bob: bob {
+			regulator-name = "vreg_bob";
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+
 		vreg_l1c_1p8: ldo1 {
 			regulator-name = "vreg_l1c_1p8";
 			regulator-min-microvolt = <1800000>;
@@ -564,6 +599,19 @@ &pon_resin {
 	status = "okay";
 };
 
+&q6asmdai {
+	/* a front end uses one DSP session for both directions: split them */
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		direction = <Q6ASM_DAI_RX>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		direction = <Q6ASM_DAI_TX>;
+	};
+};
+
 &remoteproc_adsp {
 	/*
 	 * Downstream's adsp-loader picks the image from the adsp_variant fuse;
@@ -583,6 +631,94 @@ &remoteproc_mpss {
 	status = "okay";
 };
 
+&rxmacro {
+	status = "okay";
+};
+
+&sound {
+	compatible = "qcom,sm8250-sndcard";
+	model = "Motorola Moto G 5G Plus";
+	audio-routing =
+		"IN1_HPHL", "HPHL_OUT",
+		"IN2_HPHR", "HPHR_OUT",
+		"AMIC1", "MIC BIAS1",
+		"AMIC2", "MIC BIAS2",
+		"AMIC3", "MIC BIAS3",
+		"AMIC4", "MIC BIAS3",
+		"TX SWR_ADC0", "ADC1_OUTPUT",
+		"TX SWR_ADC1", "ADC2_OUTPUT",
+		"TX SWR_ADC2", "ADC3_OUTPUT",
+		"TX SWR_ADC3", "ADC4_OUTPUT";
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+
+		cpu {
+			sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+
+		cpu {
+			sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 3 4 5>;
+	};
+};
+
 &sdhc_2 {
 	vmmc-supply = <&vreg_l9c_2p96>;
 	vqmmc-supply = <&vreg_l6c_2p96>;
@@ -674,6 +810,13 @@ google_key_n: google-key-n-state {
 		bias-pull-up;
 	};
 
+	wcd938x_reset_default: wcd938x-reset-default-state {
+		pins = "gpio57";
+		function = "gpio";
+		drive-strength = <16>;
+		output-high;
+	};
+
 	haptics_reset_n: haptics-reset-n-state {
 		pins = "gpio65";
 		function = "gpio";
@@ -682,6 +825,10 @@ haptics_reset_n: haptics-reset-n-state {
 	};
 };
 
+&txmacro {
+	status = "okay";
+};
+
 &ufs_mem_hc {
 	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;	/* ufs_reset pad */
 
