Subject: [PATCH 094/102] dt-bindings: display: panel: Add Novatek NT36672C
 based panels

Document the 6.7" 1080x2520 Tianma NT36672C DSC panel of the Motorola
moto g 5G plus.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 .../display/panel/novatek,nt36672c.yaml       | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/novatek,nt36672c.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/novatek,nt36672c.yaml b/Documentation/devicetree/bindings/display/panel/novatek,nt36672c.yaml
new file mode 100644
index 000000000..95a81ab49
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/novatek,nt36672c.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/novatek,nt36672c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT36672C based DSI display panels
+
+maintainers:
+  - Filippo Falezza <filippo.falezza@outlook.it>
+
+description:
+  The Novatek NT36672C is a display driver IC for LCD panels with DSC, used
+  in video mode over four DSI lanes.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: motorola,nairo-tianma-nt36672c
+    description: 6.7" 1080x2520 Tianma panel of the Motorola moto g 5G plus
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: 1.8 V I/O supply
+
+  reset-gpios: true
+  backlight: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "motorola,nairo-tianma-nt36672c";
+            reg = <0>;
+
+            backlight = <&wled>;
+            reset-gpios = <&pmic_gpios 3 GPIO_ACTIVE_LOW>;
+            vddio-supply = <&vreg_l1c_1p8>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+...
