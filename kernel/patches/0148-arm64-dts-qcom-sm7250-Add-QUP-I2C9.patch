From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:58 +0100
Subject: [PATCH 148/159] arm64: dts: qcom: sm7250: Add QUP I2C9

Add the I2C controller of QUP wrapper 1 serial engine 3 (I2C9 in the
downstream numbering) and its pins (GPIO 46/47), used for the haptics
driver and the loudspeaker amplifier on the Moto G 5G Plus.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index d134806beedd..129eee2d0bc8 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -812,6 +812,26 @@ &qup_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
 				interconnect-names = "qup-core", "qup-config";
 				status = "disabled";
 			};
+
+			i2c9: i2c@98c000 {
+				compatible = "qcom,geni-i2c";
+				reg = <0x0 0x0098c000 0x0 0x4000>;
+				clock-names = "se";
+				clocks = <&gcc GCC_QUPV3_WRAP1_S3_CLK>;
+				interrupts = <GIC_SPI 356 IRQ_TYPE_LEVEL_HIGH>;
+				interconnects = <&qup_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
+						 &qup_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
+						<&gem_noc MASTER_AMPSS_M0 QCOM_ICC_TAG_ACTIVE_ONLY
+						 &config_noc SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>,
+						<&aggre1_noc MASTER_QUP_1 QCOM_ICC_TAG_ALWAYS
+						 &mc_virt SLAVE_EBI_CH0 QCOM_ICC_TAG_ALWAYS>;
+				interconnect-names = "qup-core", "qup-config", "qup-memory";
+				pinctrl-0 = <&qup_i2c9_default>;
+				pinctrl-names = "default";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
 		};
 
 		refgen: regulator@ff1000 {
@@ -1925,6 +1945,13 @@ qup_uart2_default: qup-uart2-default-state {
 				pins = "gpio36", "gpio37";
 				function = "qup02";
 			};
+
+			qup_i2c9_default: qup-i2c9-default-state {
+				pins = "gpio46", "gpio47";
+				function = "qup13";
+				drive-strength = <2>;
+				bias-disable;
+			};
 		};
 
 		apps_rsc: rsc@18200000 {
