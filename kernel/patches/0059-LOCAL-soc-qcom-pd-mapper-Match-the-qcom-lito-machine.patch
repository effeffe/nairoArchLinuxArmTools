From 8de557a798facb0cdb401fb690d1cbaa7ba6bf4d Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Tue, 6 Oct 2026 23:05:46 +0100
Subject: [PATCH 59/69] LOCAL: soc: qcom: pd-mapper: Match the "qcom,lito"
 machine compatible

The nairo bootloader applies the stock dtbo, which replaces the root
compatible with "qcom,lito-nairo", "qcom,lito-moto", "qcom,lito", so the
"qcom,sm7250" entry never matches. Not for upstream.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/soc/qcom/qcom_pd_mapper.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/soc/qcom/qcom_pd_mapper.c b/drivers/soc/qcom/qcom_pd_mapper.c
index 890fc8262..0c54bd4a7 100644
--- a/drivers/soc/qcom/qcom_pd_mapper.c
+++ b/drivers/soc/qcom/qcom_pd_mapper.c
@@ -649,6 +649,8 @@ static const struct of_device_id qcom_pdm_domains[] __maybe_unused = {
 	{ .compatible = "qcom,sda660", .data = sdm660_domains, },
 	{ .compatible = "qcom,sdm660", .data = sdm660_domains, },
 	{ .compatible = "qcom,sdm670", .data = sdm670_domains, },
+	/* LOCAL: the nairo bootloader's dtbo rewrites the root compatible to "qcom,lito" */
+	{ .compatible = "qcom,lito", .data = sm6350_domains, },
 	{ .compatible = "qcom,sdm845", .data = sdm845_domains, },
 	{ .compatible = "qcom,sm4250", .data = sm6115_domains, },
 	{ .compatible = "qcom,sm6115", .data = sm6115_domains, },
