From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:57 +0100
Subject: [PATCH 147/159] ASoC: qcom: q6voice: Add mute switches

The call audio does not go through any PCM the host reads or writes:
the DSP exchanges it with the modem directly. Muting the microphone
from userspace (callaudiod mutes its capture stream) therefore has no
effect on the call.

Add "VoiceMMode1 Capture Switch" and "VoiceMMode1 Playback Switch"
controls (on means sound passes, as for ALSA mute switches) that send
VSS_IVOLUME_CMD_MUTE_V2 to the vocproc for the uplink and downlink. The
state is kept across calls and applied when the vocproc is created,
including when a call moves to new ports. Exposed through UCM as the
mixer element of the call devices, they turn the sound server's mute
into a mute of the call.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 sound/soc/qcom/qdsp6/q6cvp.c       | 26 ++++++++++++++++++
 sound/soc/qcom/qdsp6/q6cvp.h       |  1 +
 sound/soc/qcom/qdsp6/q6voice-dai.c | 42 ++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.c     | 32 +++++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.h     |  5 ++++
 5 files changed, 106 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6cvp.c b/sound/soc/qcom/qdsp6/q6cvp.c
index 907b7f7f2af5..db23c5fd46c5 100644
--- a/sound/soc/qcom/qdsp6/q6cvp.c
+++ b/sound/soc/qcom/qdsp6/q6cvp.c
@@ -46,6 +46,18 @@
 
 #define VSS_NUM_CHANNELS_MAX 8
 
+#define VSS_IVOLUME_CMD_MUTE_V2				0x0001138B
+#define VSS_IVOLUME_DIRECTION_TX			0
+#define VSS_IVOLUME_DIRECTION_RX			1
+#define VSS_IVOLUME_MUTE_RAMP_MS			20
+
+struct vss_ivolume_cmd_mute_v2_cmd {
+	struct apr_hdr hdr;
+	u16 direction;
+	u16 mute_flag;
+	u16 ramp_duration_ms;
+} __packed;
+
 struct vss_ivocproc_cmd_create_full_control_session_v2_cmd {
 	struct apr_hdr hdr;
 
@@ -324,6 +336,20 @@ int q6cvp_enable(struct q6voice_session *cvp, bool state)
 }
 EXPORT_SYMBOL_GPL(q6cvp_enable);
 
+int q6cvp_set_mute(struct q6voice_session *cvp, bool is_tx, bool mute)
+{
+	struct vss_ivolume_cmd_mute_v2_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOLUME_CMD_MUTE_V2;
+	cmd.direction = is_tx ? VSS_IVOLUME_DIRECTION_TX : VSS_IVOLUME_DIRECTION_RX;
+	cmd.mute_flag = mute;
+	cmd.ramp_duration_ms = VSS_IVOLUME_MUTE_RAMP_MS;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_set_mute);
+
 static int q6cvp_probe(struct apr_device *adev)
 {
 	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVP);
diff --git a/sound/soc/qcom/qdsp6/q6cvp.h b/sound/soc/qcom/qdsp6/q6cvp.h
index 8aaf8b445a40..4a4fce298490 100644
--- a/sound/soc/qcom/qdsp6/q6cvp.h
+++ b/sound/soc/qcom/qdsp6/q6cvp.h
@@ -16,5 +16,6 @@ int q6cvp_send_channel_info(struct q6voice_session *cvp, bool is_tx);
 int q6cvp_send_media_format(struct q6voice_session *cvp, int port_id, bool is_tx);
 int q6cvp_topology_commit(struct q6voice_session *cvp);
 int q6cvp_enable(struct q6voice_session *cvp, bool enable);
+int q6cvp_set_mute(struct q6voice_session *cvp, bool is_tx, bool mute);
 
 #endif /* _Q6_CVP_H */
diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index 17a644ae6b49..98024135c17e 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -238,7 +238,49 @@ static int q6voice_put_topology_kctrl(struct snd_kcontrol *kcontrol,
 	return 1;
 }
 
+/* switch on = sound passes, as for an ALSA mute switch */
+static int q6voice_get_switch_kctrl(struct snd_kcontrol *kcontrol,
+				    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	enum q6voice_path_type path = q6voice_get_path(mc->reg);
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+
+	ucontrol->value.integer.value[0] = !q6voice_get_mute(v, path, !!mc->shift);
+	return 0;
+}
+
+static int q6voice_put_switch_kctrl(struct snd_kcontrol *kcontrol,
+				    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	enum q6voice_path_type path = q6voice_get_path(mc->reg);
+	bool capture = !!mc->shift;
+	bool mute = !ucontrol->value.integer.value[0];
+	int ret;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+	if (mute == q6voice_get_mute(v, path, capture))
+		return 0;
+
+	ret = q6voice_set_mute(v, path, capture, mute);
+	return ret ? ret : 1;
+}
+
 static const struct snd_kcontrol_new q6voice_kcontrols[] = {
+	SOC_SINGLE_EXT("VoiceMMode1 Capture Switch", VOICEMMODE1, 1, 1, 0,
+		       q6voice_get_switch_kctrl, q6voice_put_switch_kctrl),
+	SOC_SINGLE_EXT("VoiceMMode1 Playback Switch", VOICEMMODE1, 0, 1, 0,
+		       q6voice_get_switch_kctrl, q6voice_put_switch_kctrl),
 	SOC_SINGLE_EXT("VoiceMMode1 TX Topology", VOICEMMODE1, 1, S32_MAX, 0,
 		       q6voice_get_topology_kctrl, q6voice_put_topology_kctrl),
 	SOC_SINGLE_EXT("VoiceMMode1 RX Topology", VOICEMMODE1, 0, S32_MAX, 0,
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index b5cd87adc03e..cfba47a241d5 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -27,6 +27,7 @@ struct q6voice_path {
 	enum q6voice_path_type type;
 	int tx_port, rx_port;
 	u32 tx_topo, rx_topo;
+	bool mute[2];		/* indexed by capture */
 	/* Serialize access to voice path session */
 	struct mutex lock;
 	struct q6voice_path_runtime *runtime;
@@ -106,6 +107,12 @@ static int q6voice_path_start(struct q6voice_path *p)
 		goto cvp_err;
 	}
 
+	/* a new vocproc starts unmuted */
+	if (p->mute[true])
+		q6cvp_set_mute(cvp, true, true);
+	if (p->mute[false])
+		q6cvp_set_mute(cvp, false, true);
+
 	ret = q6mvm_attach(mvm, cvp, true);
 	if (ret) {
 		dev_err(dev, "failed to attach cvp to mvm: %d\n", ret);
@@ -358,6 +365,31 @@ void q6voice_set_topology(struct q6voice *v, enum q6voice_path_type path,
 }
 EXPORT_SYMBOL_GPL(q6voice_set_topology);
 
+bool q6voice_get_mute(struct q6voice *v, enum q6voice_path_type path,
+		      bool capture)
+{
+	return v->paths[path].mute[capture];
+}
+EXPORT_SYMBOL_GPL(q6voice_get_mute);
+
+int q6voice_set_mute(struct q6voice *v, enum q6voice_path_type path,
+		     bool capture, bool mute)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	p->mute[capture] = mute;
+	if (p->runtime && p->runtime->started == 3 &&
+	    p->runtime->sessions[Q6VOICE_SERVICE_CVP])
+		ret = q6cvp_set_mute(p->runtime->sessions[Q6VOICE_SERVICE_CVP],
+				     capture, mute);
+	mutex_unlock(&p->lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_mute);
+
 MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
 MODULE_DESCRIPTION("Q6Voice driver");
 MODULE_LICENSE("GPL");
diff --git a/sound/soc/qcom/qdsp6/q6voice.h b/sound/soc/qcom/qdsp6/q6voice.h
index d24625c668ac..b2349b91179b 100644
--- a/sound/soc/qcom/qdsp6/q6voice.h
+++ b/sound/soc/qcom/qdsp6/q6voice.h
@@ -30,4 +30,9 @@ u32 q6voice_get_topology(struct q6voice *v, enum q6voice_path_type path,
 void q6voice_set_topology(struct q6voice *v, enum q6voice_path_type path,
 			  bool capture, u32 topo);
 
+bool q6voice_get_mute(struct q6voice *v, enum q6voice_path_type path,
+		      bool capture);
+int q6voice_set_mute(struct q6voice *v, enum q6voice_path_type path,
+		     bool capture, bool mute);
+
 #endif /* _Q6_VOICE_H */
