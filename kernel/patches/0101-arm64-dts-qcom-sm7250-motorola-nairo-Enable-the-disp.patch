From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 11 Oct 2026 00:16:05 +0100
Subject: [PATCH 101/113] arm64: dts: qcom: sm7250-motorola-nairo: Enable the
 display

Enable MDSS and DSI0 with the NT36672C panel: reset on PM8150L GPIO 3,
1.8 V I/O from L1C, WLED backlight. The LCDB bias rails stay as the
bootloader left them. Link the touchscreen to the panel it shares a
chip with.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 .../boot/dts/qcom/sm7250-motorola-nairo.dts   | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
index 52bea5d87..889ad6e98 100644
--- a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
+++ b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
@@ -362,6 +362,13 @@ regulators-1 {
 		compatible = "qcom,pm8150l-rpmh-regulators";
 		qcom,pmic-id = "c";
 
+		vreg_l1c_1p8: ldo1 {
+			regulator-name = "vreg_l1c_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1896000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l2c_1p3: ldo2 {
 			regulator-name = "vreg_l2c_1p3";
 			regulator-min-microvolt = <1144000>;
@@ -425,6 +432,43 @@ &ipa {
 	status = "okay";
 };
 
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+	status = "okay";
+
+	panel: panel@0 {
+		compatible = "motorola,nairo-tianma-nt36672c";
+		reg = <0>;
+
+		backlight = <&pm8150l_wled>;
+		reset-gpios = <&pm8150l_gpios 3 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l1c_1p8>;
+
+		pinctrl-0 = <&panel_reset_n>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+	status = "okay";
+};
+
 &pm7250b_charger {
 	monitored-battery = <&battery>;
 
@@ -439,6 +483,14 @@ &pm7250b_qg {
 };
 
 &pm8150l_gpios {
+	panel_reset_n: panel-reset-n-state {
+		pins = "gpio3";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		power-source = <0>;
+		bias-disable;
+		output-high;
+	};
+
 	vol_up_n: vol-up-n-state {
 		pins = "gpio5";
 		function = PMIC_GPIO_FUNC_NORMAL;
@@ -507,6 +559,7 @@ &spi7 {
 	 */
 	touchscreen@0 {
 		compatible = "novatek,NVT-ts-spi";
+		panel = <&panel>;
 		reg = <0>;
 		spi-max-frequency = <9600000>;
 
