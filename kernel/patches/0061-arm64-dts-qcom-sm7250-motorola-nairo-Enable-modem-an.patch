From 6d6b626d9631dc9ccfed9168c45e343bc4fdbb59 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Tue, 6 Oct 2026 23:05:46 +0100
Subject: [PATCH 61/69] arm64: dts: qcom: sm7250-motorola-nairo: Enable modem
 and Wi-Fi

- Add the five Wi-Fi supplies (L1A, L14A, L2C, L10C, L11C) with the
  downstream voltage ranges.
- Reserve the rmtfs buffer at 0xf1500000. Downstream allocates it
  dynamically but always at this address, and the modem expects it there
  (read from LineageOS, /sys/class/uio/uio0/maps/map0).
- Enable the modem with the device-specific firmware path, and Wi-Fi.

Tested: the modem boots, ath10k_snoc probes (WCN3990 hw1.0, firmware
WLAN.HL.3.3.1) and the phone connects to a Wi-Fi network.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 .../boot/dts/qcom/sm7250-motorola-nairo.dts   | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
index 2935e602c..8adb82338 100644
--- a/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
+++ b/arch/arm64/boot/dts/qcom/sm7250-motorola-nairo.dts
@@ -9,6 +9,7 @@
 /dts-v1/;
 
 #include <dt-bindings/arm/qcom,ids.h>
+#include <dt-bindings/firmware/qcom,scm.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
@@ -255,6 +256,20 @@ ramoops@af000000 {
 			pmsg-size = <0x40000>;
 			no-map;
 		};
+
+		/*
+		 * Downstream allocates the rmtfs buffer dynamically, but always at
+		 * this address (read from LineageOS: /sys/class/uio/uio0/maps/map0),
+		 * and the modem firmware expects it here.
+		 */
+		rmtfs_mem: rmtfs@f1500000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0x0 0xf1500000 0x0 0x280000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+		};
 	};
 };
 
@@ -279,6 +294,13 @@ vreg_s4a_1p8: smps4 {
 			regulator-always-on;
 		};
 
+		vreg_l1a_0p75: ldo1 {
+			regulator-name = "vreg_l1a_0p75";
+			regulator-min-microvolt = <752000>;
+			regulator-max-microvolt = <952000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l2a_3p1: ldo2 {
 			regulator-name = "vreg_l2a_3p1";
 			regulator-min-microvolt = <3072000>;
@@ -306,12 +328,26 @@ vreg_l12a_1p8: ldo12 {
 			regulator-max-microvolt = <1800000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
+
+		vreg_l14a_1p88: ldo14 {
+			regulator-name = "vreg_l14a_1p88";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1880000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
 	};
 
 	regulators-1 {
 		compatible = "qcom,pm8150l-rpmh-regulators";
 		qcom,pmic-id = "c";
 
+		vreg_l2c_1p3: ldo2 {
+			regulator-name = "vreg_l2c_1p3";
+			regulator-min-microvolt = <1144000>;
+			regulator-max-microvolt = <1328000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l6c_2p96: ldo6 {
 			regulator-name = "vreg_l6c_2p96";
 			regulator-min-microvolt = <1800000>;
@@ -332,6 +368,20 @@ vreg_l9c_2p96: ldo9 {
 			regulator-max-microvolt = <2960000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
+
+		vreg_l10c_3p3: ldo10 {
+			regulator-name = "vreg_l10c_3p3";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l11c_3p3: ldo11 {
+			regulator-name = "vreg_l11c_3p3";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
 	};
 };
 
@@ -394,6 +444,11 @@ &pon_resin {
 	status = "okay";
 };
 
+&remoteproc_mpss {
+	firmware-name = "qcom/sm7250/motorola/nairo/modem.mdt";
+	status = "okay";
+};
+
 &sdhc_2 {
 	vmmc-supply = <&vreg_l9c_2p96>;
 	vqmmc-supply = <&vreg_l6c_2p96>;
@@ -499,3 +554,13 @@ &usb_1_hsphy {
 
 	status = "okay";
 };
+
+&wifi {
+	vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
+	vdd-1.8-xo-supply = <&vreg_l14a_1p88>;
+	vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
+	vdd-3.3-ch0-supply = <&vreg_l10c_3p3>;
+	vdd-3.3-ch1-supply = <&vreg_l11c_3p3>;
+
+	status = "okay";
+};
