From 9db3735765e56e6dba2d5188c8f89c64eec8ec75 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 4 Oct 2026 16:28:17 +0100
Subject: [PATCH 16/69] scsi: ufs: qcom: Restrict SM7250 to a 32-bit DMA mask

On SM7250 the UFS host's DMA does not reach memory above 4 GiB while no
SMMU stream ID is described for it: transfer request descriptors placed
there are never processed (OCS stays 0xf, no completion interrupt) and the
first NOP OUT times out. Downstream runs with a 64-bit mask, but it never
resets the SMMU, so the bootloader's configuration for UFS survives.

Use a 32-bit mask for qcom,sm7250-ufshc until the stream ID is known.

Tested on nairo with linux-next 20261002 plus the SM7250 v9 series ("Add
support for SM7250", patches 03/04/09/10/11/12). With this change the
device initialises and all LUNs and partition tables are read.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
---
 drivers/ufs/host/ufs-qcom.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 7e6cb6dc4..e7e1c004c 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -8,6 +8,7 @@
 #include <linux/cleanup.h>
 #include <linux/delay.h>
 #include <linux/devfreq.h>
+#include <linux/dma-mapping.h>
 #include <linux/gpio/consumer.h>
 #include <linux/interconnect.h>
 #include <linux/interrupt.h>
@@ -2942,6 +2943,21 @@ static int ufs_qcom_tx_eqtr_notify(struct ufs_hba *hba,
 	return ret;
 }
 
+/*
+ * On SM7250 the UFS host cannot DMA above 4 GiB without an SMMU translation
+ * (no stream ID is described yet): descriptors placed there are never
+ * processed, so restrict it to a 32-bit mask.
+ */
+static int ufs_qcom_set_dma_mask(struct ufs_hba *hba)
+{
+	if (!of_device_is_compatible(hba->dev->of_node, "qcom,sm7250-ufshc") &&
+	    (hba->capabilities & MASK_64_ADDRESSING_SUPPORT) &&
+	    !dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(64)))
+		return 0;
+
+	return dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(32));
+}
+
 /*
  * struct ufs_hba_qcom_vops - UFS QCOM specific variant operations
  *
@@ -2949,6 +2965,7 @@ static int ufs_qcom_tx_eqtr_notify(struct ufs_hba *hba,
  * handshake during initialization.
  */
 static const struct ufs_hba_variant_ops ufs_hba_qcom_vops = {
+	.set_dma_mask		= ufs_qcom_set_dma_mask,
 	.name                   = "qcom",
 	.init                   = ufs_qcom_init,
 	.exit                   = ufs_qcom_exit,
