diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36672c.c b/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
new file mode 100644
index 000000000..2b8f4462f
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Novatek NT36672C DriverIC panels driver
+ *
+ * Init sequence, timings and DSC parameters from the downstream
+ * "mipi_mot_vid_tm_1080x2520_670" panel of the Motorola moto g 5G plus.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct nt36672c {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	bool handoff;
+};
+
+static const struct regulator_bulk_data nt36672c_supplies[] = {
+	{ .supply = "vddio" }, /* 1.8 V */
+};
+
+static inline struct nt36672c *to_nt36672c(struct drm_panel *panel)
+{
+	return container_of(panel, struct nt36672c, panel);
+}
+
+static void nt36672c_reset(struct nt36672c *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int nt36672c_on(struct nt36672c *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x25);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x18, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3b, 0x03, 0x20, 0x20, 0x04, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc2, 0x1b, 0xa0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5a, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0xc0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9c, 0x11);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9d, 0x11);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0xe0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x35, 0x82);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	/* DSC on */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc0, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0xcc);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x24);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x01);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 101);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 41);
+
+	/* As downstream: PPS after the on sequence; DSC is enabled by c0 03 */
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
+static int nt36672c_off(struct nt36672c *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 21);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 61);
+
+	return dsi_ctx.accum_err;
+}
+
+static int nt36672c_prepare(struct drm_panel *panel)
+{
+	struct nt36672c *ctx = to_nt36672c(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(nt36672c_supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * The bootloader leaves the panel initialized and running: keep it
+	 * that way the first time instead of resetting it, which also resets
+	 * the touch controller of this TDDI chip.
+	 */
+	if (ctx->handoff) {
+		ctx->handoff = false;
+		dev_info(dev, "keeping the panel state from the bootloader\n");
+		return 0;
+	}
+
+	usleep_range(1000, 2000);
+
+	nt36672c_reset(ctx);
+
+	ret = nt36672c_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(nt36672c_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int nt36672c_unprepare(struct drm_panel *panel)
+{
+	struct nt36672c *ctx = to_nt36672c(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = nt36672c_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(nt36672c_supplies), ctx->supplies);
+
+	return 0;
+}
+
+/* 60 Hz; the panel also runs at 90 Hz with a vertical front porch of 27 */
+static const struct drm_display_mode nt36672c_tianma_mode = {
+	.clock = (1080 + 172 + 8 + 152) * (2520 + 1316 + 4 + 26) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 172,
+	.hsync_end = 1080 + 172 + 8,
+	.htotal = 1080 + 172 + 8 + 152,
+	.vdisplay = 2520,
+	.vsync_start = 2520 + 1316,
+	.vsync_end = 2520 + 1316 + 4,
+	.vtotal = 2520 + 1316 + 4 + 26,
+	.width_mm = 67,
+	.height_mm = 157,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int nt36672c_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector,
+						    &nt36672c_tianma_mode);
+}
+
+static const struct drm_panel_funcs nt36672c_panel_funcs = {
+	.prepare = nt36672c_prepare,
+	.unprepare = nt36672c_unprepare,
+	.get_modes = nt36672c_get_modes,
+};
+
+static int nt36672c_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct nt36672c *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct nt36672c, panel,
+				   &nt36672c_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(nt36672c_supplies),
+					    nt36672c_supplies, &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	/* The bootloader leaves the panel running: don't reset it at probe */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	/* Reset deasserted at probe: the bootloader has the panel running */
+	ctx->handoff = gpiod_get_value_cansleep(ctx->reset_gpio) == 0;
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	/* DSC 1.1, 8 bpc, 8 bpp, two 540x20 slices per line */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 20;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	dsi->dsc = &ctx->dsc;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	ret = devm_drm_panel_add(dev, &ctx->panel);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to add panel\n");
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+
+	return 0;
+}
+
+static const struct of_device_id nt36672c_of_match[] = {
+	{ .compatible = "motorola,nairo-tianma-nt36672c" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, nt36672c_of_match);
+
+static struct mipi_dsi_driver nt36672c_driver = {
+	.probe = nt36672c_probe,
+	.driver = {
+		.name = "panel-novatek-nt36672c",
+		.of_match_table = nt36672c_of_match,
+	},
+};
+module_mipi_dsi_driver(nt36672c_driver);
+
+MODULE_DESCRIPTION("DRM driver for Novatek NT36672C based MIPI DSI panels");
+MODULE_LICENSE("GPL");
