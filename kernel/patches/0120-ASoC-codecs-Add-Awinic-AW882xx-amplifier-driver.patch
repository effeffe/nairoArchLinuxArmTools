+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW882xx (chip ID 0x1852) smart power amplifier
+ *
+ * Minimal driver: the amplifier is configured from a register table the
+ * vendor ships as firmware (pairs of little-endian 16-bit register address
+ * and value), then powered up while a stream is unmuted. The speaker
+ * protection algorithm that runs on the Qualcomm DSP downstream is not used;
+ * the battery voltage and temperature monitor of the downstream driver is.
+ *
+ * Register layout and sequences are from the downstream Awinic driver
+ * (Copyright (c) 2019 AWINIC Technology CO., LTD).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define AW882XX_ID			0x00
+#define AW882XX_CHIP_ID			0x1852
+#define AW882XX_SYSST			0x01
+#define AW882XX_SYSST_PLLS		BIT(0)
+#define AW882XX_SYSST_CLKS		BIT(4)
+#define AW882XX_SYSCTRL			0x04
+#define AW882XX_SYSCTRL_PWDN		BIT(0)
+#define AW882XX_SYSCTRL2		0x05
+#define AW882XX_SYSCTRL2_HMUTE		BIT(4)
+#define AW882XX_SYSCTRL2_BST_IPEAK	GENMASK(3, 0)	/* 1.5 A + 0.25 A/step */
+#define AW882XX_I2SCTRL			0x06
+#define AW882XX_I2SCTRL_SR		GENMASK(3, 0)
+#define AW882XX_I2SCTRL_FS		GENMASK(7, 6)
+#define AW882XX_I2SCTRL_CHSEL		GENMASK(11, 10)
+#define AW882XX_CHSEL_MONO		3	/* (L + R) / 2 */
+#define AW882XX_HAGCCFG4		0x0c
+#define AW882XX_HAGCCFG4_VOL		GENMASK(15, 8)
+#define AW882XX_VBAT			0x12
+#define AW882XX_TEMP			0x13
+#define AW882XX_ADC			GENMASK(9, 0)
+#define AW882XX_VTMCTRL3		0x56
+#define AW882XX_PLLCTRL1		0x66
+#define AW882XX_PLLCTRL1_CCO_MUX	BIT(14)
+#define AW882XX_EFRH			0x78
+#define AW882XX_EFRM1			0x7a
+#define AW882XX_EF_GESLP		GENMASK(9, 0)
+#define AW882XX_MAX_REG			0x7f
+
+struct aw882xx {
+	struct regmap *regmap;
+	struct gpio_desc *reset_gpio;
+	struct device *dev;
+	const char *fw_name;
+	struct mutex lock;		/* vol, mon_att */
+	unsigned int vol;
+
+	struct delayed_work monitor;
+	unsigned int vbat_level;
+	unsigned int temp_level;
+	int vbat_avg;
+	unsigned int mon_att;
+	unsigned int ipeak;
+	unsigned int ipeak_max;
+};
+
+/* volume control steps: 0.5 dB each, from -90 dB to 0 dB */
+#define AW882XX_VOL_MAX			180
+
+#define AW882XX_MONITOR_MS		3000
+
+/*
+ * Protection while playing: a step applies below 'enter' and is released
+ * above 'leave', adding 'att' (0.5 dB units) of attenuation and limiting the
+ * boost peak current to 'ipeak'. The values are those of the Motorola nairo
+ * device tree for the downstream driver.
+ */
+struct aw882xx_mon_step {
+	int enter;
+	int leave;
+	unsigned int att;
+	unsigned int ipeak;
+};
+
+/* battery voltage, mV */
+static const struct aw882xx_mon_step aw882xx_vbat_steps[] = {
+	{ 3900, 4000, 1, 9 },
+	{ 3750, 3800, 2, 9 },
+	{ 3650, 3700, 3, 9 },
+};
+
+/* die temperature, degrees Celsius */
+static const struct aw882xx_mon_step aw882xx_temp_steps[] = {
+	{  5,  7,  6, 6 },
+	{  0,  2,  9, 5 },
+	{ -5, -2, 12, 4 },
+};
+
+static const struct regmap_config aw882xx_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.max_register = AW882XX_MAX_REG,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+/* sign-extend the 10-bit current/voltage gain calibration from the efuses */
+static int aw882xx_efuse_gain(struct aw882xx *aw, unsigned int reg)
+{
+	unsigned int val;
+
+	if (regmap_read(aw->regmap, reg, &val))
+		return 0;
+
+	return sign_extend32(val & AW882XX_EF_GESLP, 9);
+}
+
+static int aw882xx_set_vcalb(struct aw882xx *aw)
+{
+	int icalk = 1000 + aw882xx_efuse_gain(aw, AW882XX_EFRM1);
+	int vcalk = 1000 + aw882xx_efuse_gain(aw, AW882XX_EFRH);
+
+	return regmap_write(aw->regmap, AW882XX_VTMCTRL3, (1 << 13) * icalk / vcalk);
+}
+
+/*
+ * The VOL field holds an attenuation: the upper nibble counts 6 dB steps and
+ * the lower nibble 0.5 dB steps (0 to 11).
+ */
+static int aw882xx_write_vol(struct aw882xx *aw)
+{
+	unsigned int att = min(AW882XX_VOL_MAX - aw->vol + aw->mon_att, AW882XX_VOL_MAX);
+
+	return regmap_update_bits(aw->regmap, AW882XX_HAGCCFG4, AW882XX_HAGCCFG4_VOL,
+				  FIELD_PREP(AW882XX_HAGCCFG4_VOL, (att / 12) << 4 | att % 12));
+}
+
+static int aw882xx_vol_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aw882xx *aw = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.integer.value[0] = aw->vol;
+	return 0;
+}
+
+static int aw882xx_vol_put(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aw882xx *aw = snd_soc_component_get_drvdata(component);
+	long vol = ucontrol->value.integer.value[0];
+	int ret;
+
+	if (vol < 0 || vol > AW882XX_VOL_MAX)
+		return -EINVAL;
+	if (vol == aw->vol)
+		return 0;
+
+	mutex_lock(&aw->lock);
+	aw->vol = vol;
+	ret = aw882xx_write_vol(aw);
+	mutex_unlock(&aw->lock);
+	return ret ? ret : 1;
+}
+
+static unsigned int aw882xx_mon_level(const struct aw882xx_mon_step *steps,
+				      unsigned int n, unsigned int level, int val)
+{
+	while (level < n && val < steps[level].enter)
+		level++;
+	while (level && val > steps[level - 1].leave)
+		level--;
+
+	return level;
+}
+
+static void aw882xx_monitor(struct work_struct *work)
+{
+	struct aw882xx *aw = container_of(to_delayed_work(work), struct aw882xx, monitor);
+	const struct aw882xx_mon_step *step;
+	unsigned int vbat, temp, att = 0, ipeak = aw->ipeak_max;
+	int mv, deg;
+
+	if (regmap_read(aw->regmap, AW882XX_VBAT, &vbat) ||
+	    regmap_read(aw->regmap, AW882XX_TEMP, &temp))
+		goto out;
+
+	/* 10-bit readings: 0 to 6025 mV, and signed degrees */
+	mv = (vbat & AW882XX_ADC) * 6025 / 1023;
+	deg = sign_extend32(temp & AW882XX_ADC, 9);
+	aw->vbat_avg = aw->vbat_avg ? (aw->vbat_avg * 2 + mv) / 3 : mv;
+
+	mutex_lock(&aw->lock);
+	aw->vbat_level = aw882xx_mon_level(aw882xx_vbat_steps, ARRAY_SIZE(aw882xx_vbat_steps),
+					   aw->vbat_level, aw->vbat_avg);
+	aw->temp_level = aw882xx_mon_level(aw882xx_temp_steps, ARRAY_SIZE(aw882xx_temp_steps),
+					   aw->temp_level, deg);
+
+	if (aw->vbat_level) {
+		step = &aw882xx_vbat_steps[aw->vbat_level - 1];
+		att = max(att, step->att);
+		ipeak = min(ipeak, step->ipeak);
+	}
+	if (aw->temp_level) {
+		step = &aw882xx_temp_steps[aw->temp_level - 1];
+		att = max(att, step->att);
+		ipeak = min(ipeak, step->ipeak);
+	}
+
+	if (att != aw->mon_att || ipeak != aw->ipeak) {
+		dev_info(aw->dev, "%d mV, %d C: attenuation %u.%u dB, boost peak %u mA\n",
+			 aw->vbat_avg, deg, att / 2, att % 2 * 5, 1500 + ipeak * 250);
+		aw->mon_att = att;
+		aw->ipeak = ipeak;
+		aw882xx_write_vol(aw);
+		regmap_update_bits(aw->regmap, AW882XX_SYSCTRL2, AW882XX_SYSCTRL2_BST_IPEAK,
+				   ipeak);
+	}
+	mutex_unlock(&aw->lock);
+out:
+	schedule_delayed_work(&aw->monitor, msecs_to_jiffies(AW882XX_MONITOR_MS));
+}
+
+static const DECLARE_TLV_DB_SCALE(aw882xx_vol_tlv, -9000, 50, 0);
+
+/* which I2S slot the speaker plays */
+static const char * const aw882xx_chsel_text[] = { "Left", "Right", "Mono" };
+static const unsigned int aw882xx_chsel_values[] = { 1, 2, AW882XX_CHSEL_MONO };
+static SOC_VALUE_ENUM_SINGLE_DECL(aw882xx_chsel_enum, AW882XX_I2SCTRL, 10, 3,
+				  aw882xx_chsel_text, aw882xx_chsel_values);
+
+static const struct snd_kcontrol_new aw882xx_controls[] = {
+	SOC_SINGLE_EXT_TLV("Playback Volume", SND_SOC_NOPM, 0, AW882XX_VOL_MAX, 0,
+			   aw882xx_vol_get, aw882xx_vol_put, aw882xx_vol_tlv),
+	SOC_ENUM("Channel Select", aw882xx_chsel_enum),
+};
+
+static int aw882xx_load_config(struct aw882xx *aw)
+{
+	const struct firmware *fw;
+	int i, ret;
+
+	ret = request_firmware(&fw, aw->fw_name, aw->dev);
+	if (ret)
+		return dev_err_probe(aw->dev, ret, "failed to load %s\n", aw->fw_name);
+
+	if (fw->size % 4) {
+		dev_err(aw->dev, "%s: bad size %zu\n", aw->fw_name, fw->size);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < fw->size; i += 4) {
+		unsigned int reg = get_unaligned_le16(fw->data + i);
+		unsigned int val = get_unaligned_le16(fw->data + i + 2);
+
+		ret = regmap_write(aw->regmap, reg, val);
+		if (ret)
+			goto out;
+	}
+
+	/* a single speaker: play the average of a stereo stream by default */
+	regmap_update_bits(aw->regmap, AW882XX_I2SCTRL, AW882XX_I2SCTRL_CHSEL,
+			   FIELD_PREP(AW882XX_I2SCTRL_CHSEL, AW882XX_CHSEL_MONO));
+
+	/* the protection monitor may only lower the boost current from here */
+	ret = regmap_read(aw->regmap, AW882XX_SYSCTRL2, &aw->ipeak_max);
+	if (ret)
+		goto out;
+	aw->ipeak_max &= AW882XX_SYSCTRL2_BST_IPEAK;
+	aw->ipeak = aw->ipeak_max;
+
+	/* stay muted and powered down until a stream is unmuted */
+	regmap_set_bits(aw->regmap, AW882XX_SYSCTRL2, AW882XX_SYSCTRL2_HMUTE);
+	regmap_set_bits(aw->regmap, AW882XX_SYSCTRL, AW882XX_SYSCTRL_PWDN);
+	ret = aw882xx_set_vcalb(aw);
+	if (!ret)
+		ret = aw882xx_write_vol(aw);
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+static int aw882xx_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct aw882xx *aw = snd_soc_component_get_drvdata(dai->component);
+	unsigned int sr, fs;
+	bool low_rate = false;
+
+	switch (params_rate(params)) {
+	case 8000:
+		sr = 0;
+		low_rate = true;
+		break;
+	case 16000:
+		sr = 3;
+		low_rate = true;
+		break;
+	case 32000:
+		sr = 6;
+		low_rate = true;
+		break;
+	case 44100:
+		sr = 7;
+		break;
+	case 48000:
+		sr = 8;
+		break;
+	case 96000:
+		sr = 9;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (params_width(params)) {
+	case 16:
+		fs = 0;
+		break;
+	case 20:
+		fs = 1;
+		break;
+	case 24:
+		fs = 2;
+		break;
+	case 32:
+		fs = 3;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	regmap_update_bits(aw->regmap, AW882XX_PLLCTRL1, AW882XX_PLLCTRL1_CCO_MUX,
+			   low_rate ? 0 : AW882XX_PLLCTRL1_CCO_MUX);
+
+	return regmap_update_bits(aw->regmap, AW882XX_I2SCTRL,
+				  AW882XX_I2SCTRL_SR | AW882XX_I2SCTRL_FS,
+				  FIELD_PREP(AW882XX_I2SCTRL_SR, sr) |
+				  FIELD_PREP(AW882XX_I2SCTRL_FS, fs));
+}
+
+static int aw882xx_mute(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct aw882xx *aw = snd_soc_component_get_drvdata(dai->component);
+	unsigned int st;
+	int ret;
+
+	if (mute) {
+		cancel_delayed_work_sync(&aw->monitor);
+		regmap_set_bits(aw->regmap, AW882XX_SYSCTRL2, AW882XX_SYSCTRL2_HMUTE);
+		return regmap_set_bits(aw->regmap, AW882XX_SYSCTRL, AW882XX_SYSCTRL_PWDN);
+	}
+
+	/* the I2S clocks run now: power up and wait for the PLL to lock */
+	regmap_clear_bits(aw->regmap, AW882XX_SYSCTRL, AW882XX_SYSCTRL_PWDN);
+	ret = regmap_read_poll_timeout(aw->regmap, AW882XX_SYSST, st,
+				       (st & (AW882XX_SYSST_PLLS | AW882XX_SYSST_CLKS)) ==
+				       (AW882XX_SYSST_PLLS | AW882XX_SYSST_CLKS),
+				       2000, 40000);
+	if (ret) {
+		dev_err(aw->dev, "not ready, SYSST %#x\n", st);
+		regmap_set_bits(aw->regmap, AW882XX_SYSCTRL, AW882XX_SYSCTRL_PWDN);
+		return ret;
+	}
+
+	ret = regmap_clear_bits(aw->regmap, AW882XX_SYSCTRL2, AW882XX_SYSCTRL2_HMUTE);
+	if (ret)
+		return ret;
+
+	aw->vbat_avg = 0;
+	schedule_delayed_work(&aw->monitor, 0);
+	return 0;
+}
+
+static const struct snd_soc_dai_ops aw882xx_dai_ops = {
+	.hw_params = aw882xx_hw_params,
+	.mute_stream = aw882xx_mute,
+	.no_capture_mute = 1,
+};
+
+static struct snd_soc_dai_driver aw882xx_dai = {
+	.name = "aw882xx-aif",
+	.playback = {
+		.stream_name = "Speaker Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |
+			 SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 |
+			 SNDRV_PCM_RATE_48000 | SNDRV_PCM_RATE_96000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+			   SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &aw882xx_dai_ops,
+};
+
+static const struct snd_soc_dapm_widget aw882xx_widgets[] = {
+	SND_SOC_DAPM_AIF_IN("AIF RX", "Speaker Playback", 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_OUTPUT("SPK"),
+};
+
+static const struct snd_soc_dapm_route aw882xx_routes[] = {
+	{ "SPK", NULL, "AIF RX" },
+};
+
+static const struct snd_soc_component_driver aw882xx_component = {
+	.controls = aw882xx_controls,
+	.num_controls = ARRAY_SIZE(aw882xx_controls),
+	.dapm_widgets = aw882xx_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(aw882xx_widgets),
+	.dapm_routes = aw882xx_routes,
+	.num_dapm_routes = ARRAY_SIZE(aw882xx_routes),
+	.endianness = 1,
+};
+
+static int aw882xx_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct aw882xx *aw;
+	unsigned int id;
+	int ret;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	aw->dev = dev;
+	aw->vol = AW882XX_VOL_MAX;
+	mutex_init(&aw->lock);
+
+	ret = devm_delayed_work_autocancel(dev, &aw->monitor, aw882xx_monitor);
+	if (ret)
+		return ret;
+	i2c_set_clientdata(client, aw);
+
+	aw->regmap = devm_regmap_init_i2c(client, &aw882xx_regmap_config);
+	if (IS_ERR(aw->regmap))
+		return dev_err_probe(dev, PTR_ERR(aw->regmap), "failed to init regmap\n");
+
+	aw->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(aw->reset_gpio), "failed to get reset GPIO\n");
+
+	if (aw->reset_gpio) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(aw->reset_gpio, 0);
+		usleep_range(2000, 3000);
+	}
+
+	ret = regmap_read(aw->regmap, AW882XX_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip ID\n");
+	if (id != AW882XX_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV, "unexpected chip ID %#x\n", id);
+
+	aw->fw_name = "aw882xx_spk_reg.bin";
