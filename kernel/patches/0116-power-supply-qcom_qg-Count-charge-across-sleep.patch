From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:55 +0100
Subject: [PATCH 116/159] power: supply: qcom_qg: Count charge across sleep

The coulomb counter integrates the battery current sampled by the poll
work. Across system suspend the work does not run, so the first sample
after resume is integrated over the whole sleep. That sample is taken
while the system is waking up and draws several hundred mA, so a night
in suspend at a few mA was counted as hours at full load: the reported
capacity fell from 100% to 59% overnight on the Moto G 5G Plus while
the battery voltage still read 4.24 V.

Add system sleep PM ops. On suspend, stop the poll work and take a
last sample; on resume, restart the integration from the resume time
instead of the last sample, so the sleep itself is not integrated.

The QG hardware keeps measuring while the SoC sleeps and latches a
"good OCV" once the battery has rested. After a sleep of at least 30
minutes (the downstream threshold), and if a new good OCV was latched,
re-anchor the charge to it through the OCV curve, as downstream does;
this also accounts for the charge used during the sleep.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 drivers/power/supply/qcom_qg.c | 79 ++++++++++++++++++++++++++++++++++
 1 file changed, 79 insertions(+)

diff --git a/drivers/power/supply/qcom_qg.c b/drivers/power/supply/qcom_qg.c
index d4ae8201006c..86312ffa3f49 100644
--- a/drivers/power/supply/qcom_qg.c
+++ b/drivers/power/supply/qcom_qg.c
@@ -39,7 +39,10 @@
 #define QG_STATUS1_OK			BIT(7)
 #define QG_STATUS1_BATT_PRESENT		BIT(0)
 
+#define QG_STATUS2			0x09
+#define QG_STATUS2_GOOD_OCV		BIT(1)
 #define QG_S7_PON_OCV_V			0x70
+#define QG_S3_GOOD_OCV_V		0x74
 #define QG_LAST_ADC_V			0xc0
 #define QG_LAST_BURST_AVG_I		0xc6
 
@@ -62,6 +65,8 @@
 #define QG_DEFAULT_RBAT_UOHM		100000
 /* No battery temperature input yet */
 #define QG_ASSUMED_TEMP_C		25
+/* Sleep needed before a good OCV replaces the charge count, as downstream */
+#define QG_GOOD_OCV_MIN_SLEEP_S		1800
 
 struct qcom_qg {
 	struct device *dev;
@@ -82,6 +87,9 @@ struct qcom_qg {
 	int ocv_uv;
 	s64 charge_uah;
 	ktime_t last_sample;
+
+	ktime_t suspend_time;
+	u16 good_ocv_raw;
 };
 
 static int qcom_qg_read16(struct qcom_qg *qg, u32 addr, u16 *val)
@@ -345,6 +353,7 @@ static int qcom_qg_probe(struct platform_device *pdev)
 
 	qg->dev = dev;
 	mutex_init(&qg->lock);
+	platform_set_drvdata(pdev, qg);
 
 	qg->regmap = dev_get_regmap(dev->parent, NULL);
 	if (!qg->regmap)
@@ -401,6 +410,75 @@ static int qcom_qg_probe(struct platform_device *pdev)
 	return 0;
 }
 
+/*
+ * While the system sleeps, the QG takes a "good OCV" reading once the battery
+ * has rested; the S3 good OCV register holds the latest one.
+ */
+static int qcom_qg_read_good_ocv(struct qcom_qg *qg, u16 *raw)
+{
+	u8 status;
+	int ret;
+
+	ret = regmap_raw_read(qg->regmap, qg->base + QG_STATUS2, &status, 1);
+	if (ret)
+		return ret;
+	if (!(status & QG_STATUS2_GOOD_OCV))
+		return -ENODATA;
+
+	return qcom_qg_read16(qg, qg->base + QG_S3_GOOD_OCV_V, raw);
+}
+
+static int qcom_qg_suspend(struct device *dev)
+{
+	struct qcom_qg *qg = dev_get_drvdata(dev);
+
+	cancel_delayed_work_sync(&qg->work);
+
+	mutex_lock(&qg->lock);
+	qcom_qg_update(qg);
+	qg->suspend_time = qg->last_sample;
+	if (qcom_qg_read_good_ocv(qg, &qg->good_ocv_raw))
+		qg->good_ocv_raw = 0;
+	mutex_unlock(&qg->lock);
+
+	return 0;
+}
+
+static int qcom_qg_resume(struct device *dev)
+{
+	struct qcom_qg *qg = dev_get_drvdata(dev);
+	ktime_t now = ktime_get_boottime();
+	s64 slept_s = ktime_ms_delta(now, qg->suspend_time) / 1000;
+	u16 raw;
+	int ocv_uv;
+
+	mutex_lock(&qg->lock);
+
+	/*
+	 * The current measured now is the system waking up, not what it drew
+	 * while asleep, so don't count the sleep with it. After a long enough
+	 * sleep, take the charge from a new good OCV instead.
+	 */
+	qg->last_sample = now;
+
+	if (slept_s >= QG_GOOD_OCV_MIN_SLEEP_S &&
+	    !qcom_qg_read_good_ocv(qg, &raw) && raw != qg->good_ocv_raw) {
+		ocv_uv = qcom_qg_raw_to_uv(raw);
+		qg->charge_uah = div_s64((s64)qcom_qg_ocv_to_pct(qg, ocv_uv) * qg->full_uah, 100);
+		dev_dbg(dev, "slept %llds, good OCV %duV: %d%%\n",
+			slept_s, ocv_uv, qcom_qg_capacity(qg));
+	}
+
+	mutex_unlock(&qg->lock);
+
+	power_supply_changed(qg->psy);
+	schedule_delayed_work(&qg->work, msecs_to_jiffies(QG_POLL_MS));
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(qcom_qg_pm_ops, qcom_qg_suspend, qcom_qg_resume);
+
 static const struct of_device_id qcom_qg_of_match[] = {
 	{ .compatible = "qcom,pm7250b-qg" },
 	{ }
@@ -411,6 +489,7 @@ static struct platform_driver qcom_qg_driver = {
 	.driver = {
 		.name = "qcom-qg",
 		.of_match_table = qcom_qg_of_match,
+		.pm = pm_sleep_ptr(&qcom_qg_pm_ops),
 	},
 	.probe = qcom_qg_probe,
 };
