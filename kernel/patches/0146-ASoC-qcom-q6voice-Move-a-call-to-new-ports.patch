From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:57 +0100
Subject: [PATCH 146/159] ASoC: qcom: q6voice: Move a call to new ports

The vocproc (CVP) session is created for one pair of AFE ports, when
both directions of the voice PCM are open. Changing the Voice Mixer
routing during a call, as userspace does to switch between earpiece
and speakerphone, only updated the stored port: the call kept playing
to the old backend, which DAPM had just disconnected, and went silent.

When a new port is routed while the path runs, stop it, release the
vocproc and start the path again, which creates the vocproc on the new
ports. Unrouting the old port (index 0) is only stored, so the
restart happens once, with the new port.

Update the DAPM routing before the port, so the new backend is already
started when the vocproc attaches to it.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 sound/soc/qcom/qdsp6/q6voice-dai.c |  4 +++-
 sound/soc/qcom/qdsp6/q6voice.c     | 38 ++++++++++++++++++++++++++----
 2 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index 419f2b0fb53b..17a644ae6b49 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -161,12 +161,14 @@ static int q6voice_put_mixer(struct snd_kcontrol *kcontrol,
 		return -EINVAL;
 	}
 
+	/* (dis)connect the backend first: a running call moves onto it */
+	snd_soc_dapm_mixer_update_power(dapm, kcontrol, val, NULL);
+
 	if (val)
 		q6voice_set_port(v, path, capture, mc->reg);
 	else if (q6voice_get_port(v, path, capture) == mc->reg)
 		q6voice_set_port(v, path, capture, 0);
 
-	snd_soc_dapm_mixer_update_power(dapm, kcontrol, val, NULL);
 	return 1;
 }
 
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index 45954740130a..b5cd87adc03e 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -180,6 +180,10 @@ static void q6voice_path_stop(struct q6voice_path *p)
 	if (ret)
 		dev_err(dev, "failed to stop voice: %d\n", ret);
 
+	/* a failed restart leaves no vocproc behind */
+	if (!cvp)
+		return;
+
 	ret = q6mvm_attach(mvm, cvp, false);
 	if (ret)
 		dev_err(dev, "failed to detach cvp from mvm: %d\n", ret);
@@ -189,6 +193,23 @@ static void q6voice_path_stop(struct q6voice_path *p)
 		dev_err(dev, "failed to disable cvp: %d\n", ret);
 }
 
+/* The vocproc is created for a pair of ports: rebuild it on new ones */
+static void q6voice_path_restart(struct q6voice_path *p)
+{
+	struct q6voice_session **cvp = &p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	int ret;
+
+	q6voice_path_stop(p);
+	if (*cvp) {
+		q6voice_session_release(*cvp);
+		*cvp = NULL;
+	}
+
+	ret = q6voice_path_start(p);
+	if (ret)
+		dev_err(p->v->dev, "failed to restart path %d: %d\n", p->type, ret);
+}
+
 static void q6voice_path_destroy(struct q6voice_path *p)
 {
 	struct q6voice_path_runtime *runtime = p->runtime;
@@ -296,11 +317,20 @@ void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
 		      bool capture, int index)
 {
 	struct q6voice_path *p = &v->paths[path];
+	int *port = capture ? &p->tx_port : &p->rx_port;
 
-	if (capture)
-		p->tx_port = index;
-	else
-		p->rx_port = index;
+	mutex_lock(&p->lock);
+	if (*port != index) {
+		*port = index;
+		/*
+		 * Moving a running call to another device (speakerphone):
+		 * unrouting the old port (index 0) only takes effect with
+		 * the next port.
+		 */
+		if (index && p->runtime && p->runtime->started == 3)
+			q6voice_path_restart(p);
+	}
+	mutex_unlock(&p->lock);
 }
 EXPORT_SYMBOL_GPL(q6voice_set_port);
 
