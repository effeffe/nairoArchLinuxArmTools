From c6660ee1f3f95484438c8655e37215ec357256e8 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Mon, 5 Oct 2026 15:02:08 +0100
Subject: [PATCH 40/69] LOCAL: soc: qcom: ubwc: Match the "qcom,lito" machine
 compatible

The nairo bootloader applies the stock dtbo, which replaces the root
compatible with "qcom,lito-nairo", "qcom,lito-moto", "qcom,lito", so the
"qcom,sm7250" entry never matches and msm fails to probe with "Couldn't
find UBWC config data for this platform". Not for upstream.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/soc/qcom/ubwc_config.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/soc/qcom/ubwc_config.c b/drivers/soc/qcom/ubwc_config.c
index 456995699..0ef04d2f2 100644
--- a/drivers/soc/qcom/ubwc_config.c
+++ b/drivers/soc/qcom/ubwc_config.c
@@ -174,6 +174,11 @@ static const struct of_device_id qcom_ubwc_configs[] __maybe_unused = {
 	{ .compatible = "qcom,sm7150", .data = &ubwc_2_0_hbb14, },
 	{ .compatible = "qcom,sm7225", .data = &ubwc_2_0_hbb14, },
 	{ .compatible = "qcom,sm7250", .data = &ubwc_3_0_hbb14, },
+	/*
+	 * LOCAL: the Motorola nairo bootloader applies the stock dtbo, which
+	 * replaces the root compatible with "qcom,lito-nairo", "qcom,lito".
+	 */
+	{ .compatible = "qcom,lito", .data = &ubwc_3_0_hbb14, },
 	{ .compatible = "qcom,sm7325", .data = &ubwc_3_1_hbb14, },
 	{ .compatible = "qcom,sm8150", .data = &ubwc_3_0_hbb15, },
 	{ .compatible = "qcom,sm8250", .data = &ubwc_4_0_hbb16, },
