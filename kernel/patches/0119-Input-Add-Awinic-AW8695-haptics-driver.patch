diff --git a/drivers/input/misc/aw8695.c b/drivers/input/misc/aw8695.c
new file mode 100644
index 000000000000..3128c61641db
--- /dev/null
+++ b/drivers/input/misc/aw8695.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW8695 LRA haptic driver
+ *
+ * The chip can play waveforms from its RAM, stream them over I2C, or drive
+ * the motor continuously at its resonant frequency (F0), tracking it through
+ * the back-EMF. This driver only uses the continuous mode, which needs no
+ * waveform data, and exposes it as a force-feedback rumble device.
+ *
+ * Register layout and the configuration sequence are from the downstream
+ * Awinic driver (Copyright (c) 2018 AWINIC Technology CO., LTD).
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define AW8695_REG_ID			0x00
+#define AW8695_SOFT_RESET		0xaa
+#define AW8695_CHIP_ID			0x95
+#define AW8695_REG_SYSINT		0x02
+#define AW8695_REG_SYSINTM		0x03
+#define AW8695_SYSINTM_UVLO_OFF		BIT(5)
+#define AW8695_REG_SYSCTRL		0x04
+#define AW8695_SYSCTRL_STANDBY		BIT(0)
+#define AW8695_SYSCTRL_BST_MODE		BIT(1)
+#define AW8695_SYSCTRL_PLAY_MODE	GENMASK(3, 2)
+#define AW8695_SYSCTRL_PLAY_MODE_CONT	(2 << 2)
+#define AW8695_SYSCTRL_RAMINIT		BIT(5)
+#define AW8695_REG_GO			0x05
+#define AW8695_GO			BIT(0)
+#define AW8695_REG_DATCTRL		0x2b
+#define AW8695_DATCTRL_LPF_ENABLE	BIT(5)
+#define AW8695_DATCTRL_FC		GENMASK(7, 6)
+#define AW8695_DATCTRL_FC_1000HZ	(3 << 6)
+#define AW8695_REG_PWMPRC		0x2d
+#define AW8695_PWMPRC_PRC		BIT(7)
+#define AW8695_REG_PWMDBG		0x2e
+#define AW8695_PWMDBG_PWM_MODE		GENMASK(6, 5)
+#define AW8695_PWMDBG_PWM_24K		(2 << 5)
+#define AW8695_REG_BSTDBG1		0x31
+#define AW8695_REG_BSTDBG2		0x32
+#define AW8695_REG_BSTDBG3		0x33
+#define AW8695_REG_BSTCFG		0x34
+#define AW8695_BSTCFG_PEAKCUR		GENMASK(2, 0)
+#define AW8695_BSTCFG_PEAKCUR_2A	1
+#define AW8695_REG_ANADBG		0x35
+#define AW8695_ANADBG_IOC		GENMASK(3, 2)
+#define AW8695_ANADBG_IOC_4P65A		(3 << 2)
+#define AW8695_REG_PRLVL		0x3e
+#define AW8695_PRLVL_PR			BIT(7)
+#define AW8695_REG_GLB_STATE		0x46
+#define AW8695_GLB_STATE_MASK		GENMASK(3, 0)
+#define AW8695_REG_BST_AUTO		0x47
+#define AW8695_BST_AUTO_AUTOSW		BIT(2)
+#define AW8695_REG_CONT_CTRL		0x48
+#define AW8695_CONT_CTRL_AUTO_BRK	BIT(0)
+#define AW8695_CONT_CTRL_O2C		BIT(1)
+#define AW8695_CONT_CTRL_F0_DETECT	BIT(2)
+#define AW8695_CONT_CTRL_CLOSE_LOOP	BIT(3)
+#define AW8695_CONT_CTRL_BY_TRIG	BIT(4)
+#define AW8695_CONT_CTRL_WAIT_PERIOD	GENMASK(6, 5)
+#define AW8695_CONT_CTRL_ZC_DETECT	BIT(7)
+#define AW8695_REG_F_PRE_H		0x49
+#define AW8695_REG_F_PRE_L		0x4a
+#define AW8695_REG_TD_H			0x4b
+#define AW8695_REG_TD_L			0x4c
+#define AW8695_REG_TSET			0x4d
+#define AW8695_REG_R_SPARE		0x5d
+#define AW8695_REG_DETCTRL		0x5f
+#define AW8695_DETCTRL_DIAG_GO		BIT(0)
+#define AW8695_DETCTRL_PROTECT_NO_ACTION BIT(5)
+#define AW8695_REG_ADCTEST		0x66
+#define AW8695_ADCTEST_VBAT_HW_COMP	BIT(6)
+#define AW8695_REG_ZC_THRSH_H		0x72
+#define AW8695_REG_ZC_THRSH_L		0x73
+#define AW8695_REG_BEMF_VTHH_H		0x74
+#define AW8695_REG_BEMF_VTHH_L		0x75
+#define AW8695_REG_BEMF_VTHL_H		0x76
+#define AW8695_REG_BEMF_VTHL_L		0x77
+#define AW8695_REG_BEMF_NUM		0x78
+#define AW8695_BEMF_NUM_BRK		GENMASK(3, 0)
+#define AW8695_REG_TIME_NZC		0x7a
+#define AW8695_REG_DRV_LVL		0x7b
+#define AW8695_REG_DRV_LVL_OV		0x7c
+#define AW8695_MAX_REG			0x7f
+
+/* F_PRE holds the period in units of 2.6 us: 1e9 / (f0 [0.1 Hz] * 260) */
+#define AW8695_F0_COEFF			260
+
+struct aw8695 {
+	struct i2c_client *client;
+	struct regmap *regmap;
+	struct gpio_desc *reset_gpio;
+	struct input_dev *input;
+	struct work_struct play_work;
+	bool playing;
+
+	u32 f0;			/* resonant frequency, 0.1 Hz */
+	u32 drv_lvl;
+	u32 drv_lvl_ov;
+	u32 brk_num;
+	u32 td;
+	u32 zc_thr;
+};
+
+static const struct regmap_config aw8695_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = AW8695_MAX_REG,
+};
+
+static int aw8695_standby(struct aw8695 *aw)
+{
+	unsigned int state;
+	int ret;
+
+	ret = regmap_clear_bits(aw->regmap, AW8695_REG_GO, AW8695_GO);
+	if (ret)
+		return ret;
+
+	/* the brake runs after GO is cleared; wait for it to finish */
+	regmap_read_poll_timeout(aw->regmap, AW8695_REG_GLB_STATE, state,
+				 !(state & AW8695_GLB_STATE_MASK), 2000, 200000);
+
+	ret = regmap_set_bits(aw->regmap, AW8695_REG_SYSINTM, AW8695_SYSINTM_UVLO_OFF);
+	if (ret)
+		return ret;
+
+	return regmap_set_bits(aw->regmap, AW8695_REG_SYSCTRL, AW8695_SYSCTRL_STANDBY);
+}
+
+static int aw8695_play_cont(struct aw8695 *aw)
+{
+	unsigned int f_pre = 1000000000 / (aw->f0 * AW8695_F0_COEFF);
+	unsigned int sysint;
+	int ret;
+
+	/* continuous mode, boost bypassed, active */
+	regmap_update_bits(aw->regmap, AW8695_REG_SYSCTRL,
+			   AW8695_SYSCTRL_PLAY_MODE | AW8695_SYSCTRL_BST_MODE,
+			   AW8695_SYSCTRL_PLAY_MODE_CONT);
+	regmap_clear_bits(aw->regmap, AW8695_REG_SYSCTRL, AW8695_SYSCTRL_STANDBY);
+	regmap_read(aw->regmap, AW8695_REG_SYSINT, &sysint);
+	regmap_clear_bits(aw->regmap, AW8695_REG_SYSINTM, AW8695_SYSINTM_UVLO_OFF);
+
+	regmap_write(aw->regmap, AW8695_REG_F_PRE_H, (f_pre >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8695_REG_F_PRE_L, f_pre & 0xff);
+
+	regmap_update_bits(aw->regmap, AW8695_REG_DATCTRL,
+			   AW8695_DATCTRL_FC | AW8695_DATCTRL_LPF_ENABLE,
+			   AW8695_DATCTRL_FC_1000HZ | AW8695_DATCTRL_LPF_ENABLE);
+
+	/* closed loop, zero-cross detection, auto brake, started by GO */
+	regmap_write(aw->regmap, AW8695_REG_CONT_CTRL,
+		     AW8695_CONT_CTRL_ZC_DETECT | AW8695_CONT_CTRL_CLOSE_LOOP |
+		     AW8695_CONT_CTRL_AUTO_BRK);
+
+	regmap_write(aw->regmap, AW8695_REG_TD_H, (aw->td >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8695_REG_TD_L, aw->td & 0xff);
+	regmap_write(aw->regmap, AW8695_REG_TSET, 0x12);
+
+	regmap_write(aw->regmap, AW8695_REG_ZC_THRSH_H, (aw->zc_thr >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8695_REG_ZC_THRSH_L, aw->zc_thr & 0xff);
+
+	regmap_write(aw->regmap, AW8695_REG_BEMF_VTHH_H, 0x10);
+	regmap_write(aw->regmap, AW8695_REG_BEMF_VTHH_L, 0x08);
+	regmap_write(aw->regmap, AW8695_REG_BEMF_VTHL_H, 0x03);
+	regmap_write(aw->regmap, AW8695_REG_BEMF_VTHL_L, 0xf8);
+	regmap_update_bits(aw->regmap, AW8695_REG_BEMF_NUM, AW8695_BEMF_NUM_BRK,
+			   aw->brk_num);
+	regmap_write(aw->regmap, AW8695_REG_TIME_NZC, 0x23);
+
+	regmap_write(aw->regmap, AW8695_REG_DRV_LVL, aw->drv_lvl);
+	regmap_write(aw->regmap, AW8695_REG_DRV_LVL_OV, aw->drv_lvl_ov);
+
+	ret = regmap_set_bits(aw->regmap, AW8695_REG_GO, AW8695_GO);
+	if (ret)
+		dev_err(&aw->client->dev, "failed to start: %d\n", ret);
+
+	return ret;
+}
+
+static void aw8695_play_work(struct work_struct *work)
+{
+	struct aw8695 *aw = container_of(work, struct aw8695, play_work);
+
+	if (READ_ONCE(aw->playing))
+		aw8695_play_cont(aw);
+	else
+		aw8695_standby(aw);
+}
+
+static int aw8695_play_effect(struct input_dev *dev, void *data,
+			      struct ff_effect *effect)
+{
+	struct aw8695 *aw = input_get_drvdata(dev);
+
+	WRITE_ONCE(aw->playing, effect->u.rumble.strong_magnitude ||
+				effect->u.rumble.weak_magnitude);
+	schedule_work(&aw->play_work);
+
+	return 0;
+}
+
+static void aw8695_close(struct input_dev *dev)
+{
+	struct aw8695 *aw = input_get_drvdata(dev);
+
+	cancel_work_sync(&aw->play_work);
+	WRITE_ONCE(aw->playing, false);
+	aw8695_standby(aw);
+}
+
+static int aw8695_hw_init(struct aw8695 *aw)
+{
+	struct device *dev = &aw->client->dev;
+	unsigned int id, val;
+	int ret;
+
+	if (aw->reset_gpio) {
+		gpiod_set_value_cansleep(aw->reset_gpio, 1);
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(aw->reset_gpio, 0);
+		usleep_range(2000, 3000);
+	}
+
+	ret = regmap_read(aw->regmap, AW8695_REG_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip ID\n");
+	if (id != AW8695_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV, "unexpected chip ID %#x\n", id);
+
+	regmap_write(aw->regmap, AW8695_REG_ID, AW8695_SOFT_RESET);
+	usleep_range(1000, 2000);
+
+	ret = aw8695_standby(aw);
+	if (ret)
+		return ret;
+
+	regmap_update_bits(aw->regmap, AW8695_REG_PWMDBG, AW8695_PWMDBG_PWM_MODE,
+			   AW8695_PWMDBG_PWM_24K);
+	regmap_write(aw->regmap, AW8695_REG_BSTDBG1, 0x30);
+	regmap_write(aw->regmap, AW8695_REG_BSTDBG2, 0xeb);
+	regmap_write(aw->regmap, AW8695_REG_BSTDBG3, 0xd4);
+	regmap_write(aw->regmap, AW8695_REG_TSET, 0x12);
+	regmap_write(aw->regmap, AW8695_REG_R_SPARE, 0x68);
+	regmap_update_bits(aw->regmap, AW8695_REG_ANADBG, AW8695_ANADBG_IOC,
+			   AW8695_ANADBG_IOC_4P65A);
+	regmap_update_bits(aw->regmap, AW8695_REG_BSTCFG, AW8695_BSTCFG_PEAKCUR,
+			   AW8695_BSTCFG_PEAKCUR_2A);
+
+	/* no motor protection, manual boost */
+	regmap_set_bits(aw->regmap, AW8695_REG_DETCTRL,
+			AW8695_DETCTRL_PROTECT_NO_ACTION);
+	regmap_clear_bits(aw->regmap, AW8695_REG_PWMPRC, AW8695_PWMPRC_PRC);
+	regmap_clear_bits(aw->regmap, AW8695_REG_PRLVL, AW8695_PRLVL_PR);
+	regmap_clear_bits(aw->regmap, AW8695_REG_BST_AUTO, AW8695_BST_AUTO_AUTOSW);
+
+	/* offset calibration */
+	regmap_set_bits(aw->regmap, AW8695_REG_SYSCTRL, AW8695_SYSCTRL_RAMINIT);
+	regmap_set_bits(aw->regmap, AW8695_REG_DETCTRL, AW8695_DETCTRL_DIAG_GO);
+	ret = regmap_read_poll_timeout(aw->regmap, AW8695_REG_DETCTRL, val,
+				       !(val & AW8695_DETCTRL_DIAG_GO), 100, 20000);
+	if (ret)
+		dev_warn(dev, "offset calibration timed out\n");
+	regmap_clear_bits(aw->regmap, AW8695_REG_SYSCTRL, AW8695_SYSCTRL_RAMINIT);
+
+	/* compensate the drive level for the battery voltage in hardware */
+	return regmap_set_bits(aw->regmap, AW8695_REG_ADCTEST,
+			       AW8695_ADCTEST_VBAT_HW_COMP);
+}
+
+static int aw8695_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct aw8695 *aw;
+	int ret;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	aw->client = client;
+	INIT_WORK(&aw->play_work, aw8695_play_work);
+
+	aw->regmap = devm_regmap_init_i2c(client, &aw8695_regmap_config);
+	if (IS_ERR(aw->regmap))
+		return dev_err_probe(dev, PTR_ERR(aw->regmap), "failed to init regmap\n");
+
+	aw->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(aw->reset_gpio), "failed to get reset GPIO\n");
+
+	/* defaults from the downstream driver */
+	aw->f0 = 2050;
+	aw->drv_lvl = 0x6e;
+	aw->drv_lvl_ov = 0x78;
+	aw->brk_num = 3;
+	aw->td = 0x6c;
+	aw->zc_thr = 0xff1;
+	device_property_read_u32(dev, "awinic,f0-decihertz", &aw->f0);
+	device_property_read_u32(dev, "awinic,cont-drive-level", &aw->drv_lvl);
+	device_property_read_u32(dev, "awinic,cont-overdrive-level", &aw->drv_lvl_ov);
+	device_property_read_u32(dev, "awinic,cont-brake-cycles", &aw->brk_num);
+	device_property_read_u32(dev, "awinic,cont-td", &aw->td);
+	device_property_read_u32(dev, "awinic,cont-zc-threshold", &aw->zc_thr);
+	if (!aw->f0)
+		return dev_err_probe(dev, -EINVAL, "invalid F0\n");
+
+	ret = aw8695_hw_init(aw);
+	if (ret)
+		return ret;
+
+	aw->input = devm_input_allocate_device(dev);
+	if (!aw->input)
+		return -ENOMEM;
+
+	aw->input->name = "aw8695-haptics";
+	aw->input->id.bustype = BUS_I2C;
+	aw->input->close = aw8695_close;
+	input_set_drvdata(aw->input, aw);
+	input_set_capability(aw->input, EV_FF, FF_RUMBLE);
+
+	ret = input_ff_create_memless(aw->input, NULL, aw8695_play_effect);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to create force feedback\n");
+
+	ret = input_register_device(aw->input);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register input device\n");
+
+	i2c_set_clientdata(client, aw);
+
+	return 0;
+}
+
+static int aw8695_suspend(struct device *dev)
+{
+	struct aw8695 *aw = dev_get_drvdata(dev);
+
+	cancel_work_sync(&aw->play_work);
+	if (aw->playing)
+		aw8695_standby(aw);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(aw8695_pm_ops, aw8695_suspend, NULL);
+
+static const struct of_device_id aw8695_of_match[] = {
+	{ .compatible = "awinic,aw8695" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw8695_of_match);
+
+static struct i2c_driver aw8695_driver = {
+	.driver = {
+		.name = "aw8695",
+		.of_match_table = aw8695_of_match,
+		.pm = pm_sleep_ptr(&aw8695_pm_ops),
+	},
+	.probe = aw8695_probe,
+};
+module_i2c_driver(aw8695_driver);
+
+MODULE_DESCRIPTION("Awinic AW8695 LRA haptic driver");
+MODULE_LICENSE("GPL");
