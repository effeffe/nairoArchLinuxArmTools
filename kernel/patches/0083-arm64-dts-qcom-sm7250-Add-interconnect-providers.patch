From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sat, 10 Oct 2026 22:47:29 +0100
Subject: [PATCH 083/113] arm64: dts: qcom: sm7250: Add interconnect providers

Add the NoC providers at the addresses of the downstream QoS windows,
with the virtual providers as children of the NoC whose space they
share in the downstream description.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 82 ++++++++++++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index 282ab7d2f..91c120e42 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -6,6 +6,7 @@
 #include <dt-bindings/clock/qcom,gpucc-sm8250.h>
 #include <dt-bindings/clock/qcom,rpmh.h>
 #include <dt-bindings/clock/qcom,sm7250-gcc.h>
+#include <dt-bindings/interconnect/qcom,sm7250-rpmh.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/mailbox/qcom-ipcc.h>
 #include <dt-bindings/power/qcom,rpmhpd.h>
@@ -632,6 +633,60 @@ uart2: serial@988000 {
 			};
 		};
 
+		config_noc: interconnect@1500000 {
+			compatible = "qcom,sm7250-config-noc";
+			reg = <0x0 0x01500000 0x0 0x28000>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
+		system_noc: interconnect@1620000 {
+			compatible = "qcom,sm7250-system-noc";
+			reg = <0x0 0x01620000 0x0 0x19200>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+
+			ipa_virt: interconnect-0 {
+				compatible = "qcom,sm7250-ipa-virt";
+				#interconnect-cells = <2>;
+				qcom,bcm-voters = <&apps_bcm_voter>;
+			};
+
+			qup_virt: interconnect-1 {
+				compatible = "qcom,sm7250-qup-virt";
+				#interconnect-cells = <2>;
+				qcom,bcm-voters = <&apps_bcm_voter>;
+			};
+		};
+
+		aggre1_noc: interconnect@16e0000 {
+			compatible = "qcom,sm7250-aggre1-noc";
+			reg = <0x0 0x016e0000 0x0 0x15080>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
+		aggre2_noc: interconnect@1700000 {
+			compatible = "qcom,sm7250-aggre2-noc";
+			reg = <0x0 0x01700000 0x0 0x23080>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
+		compute_noc: interconnect@1733000 {
+			compatible = "qcom,sm7250-compute-noc";
+			reg = <0x0 0x01733000 0x0 0xa180>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
+		mmss_noc: interconnect@1740000 {
+			compatible = "qcom,sm7250-mmss-noc";
+			reg = <0x0 0x01740000 0x0 0x1c100>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
 		ufs_mem_hc: ufshc@1d84000 {
 			compatible = "qcom,sm7250-ufshc", "qcom,ufshc",
 				     "jedec,ufs-2.0";
@@ -1005,6 +1060,33 @@ usb_1_hsphy: phy@88e3000 {
 			status = "disabled";
 		};
 
+		dc_noc: interconnect@9160000 {
+			compatible = "qcom,sm7250-dc-noc";
+			reg = <0x0 0x09160000 0x0 0x3200>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
+		gem_noc: interconnect@9680000 {
+			compatible = "qcom,sm7250-gem-noc";
+			reg = <0x0 0x09680000 0x0 0x3e200>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+
+			mc_virt: interconnect-0 {
+				compatible = "qcom,sm7250-mc-virt";
+				#interconnect-cells = <2>;
+				qcom,bcm-voters = <&apps_bcm_voter>;
+			};
+		};
+
+		npu_noc: interconnect@9990000 {
+			compatible = "qcom,sm7250-npu-noc";
+			reg = <0x0 0x09990000 0x0 0x1600>;
+			#interconnect-cells = <2>;
+			qcom,bcm-voters = <&apps_bcm_voter>;
+		};
+
 		usb_1: usb@a600000 {
 			compatible = "qcom,sm7250-dwc3", "qcom,snps-dwc3";
 			reg = <0x0 0x0a600000 0x0 0xfc100>;
