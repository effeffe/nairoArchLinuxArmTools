From bba231e6d82b024ab44f8f2d1c291a96129dbb1a Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Mon, 5 Oct 2026 15:02:06 +0100
Subject: [PATCH 34/69] clk: qcom: gpucc-sm8250: Add SM7250 support

The SM7250 (Lito) GPU clock controller matches SM8250 except for the
GPU_CC_PLL1 configuration: CONFIG_CTL_HI1 is 0x329a699c instead of
0x029a699c and TEST_CTL_HI1 is 0x01800000, as in the downstream
gpucc-lito driver. Select the PLL configuration from the match data.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/clk/qcom/gpucc-sm8250.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/qcom/gpucc-sm8250.c b/drivers/clk/qcom/gpucc-sm8250.c
index cc77fd03d..48dc5709b 100644
--- a/drivers/clk/qcom/gpucc-sm8250.c
+++ b/drivers/clk/qcom/gpucc-sm8250.c
@@ -6,6 +6,7 @@
 #include <linux/clk-provider.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 
 #include <dt-bindings/clock/qcom,gpucc-sm8250.h>
@@ -47,6 +48,19 @@ static const struct alpha_pll_config gpu_cc_pll1_config = {
 	.user_ctl_hi1_val = 0x00000000,
 };
 
+/* SM7250 (lito) uses the same block with a different PLL1 setup */
+static const struct alpha_pll_config sm7250_gpu_cc_pll1_config = {
+	.l = 0x1a,
+	.alpha = 0xaaa,
+	.config_ctl_val = 0x20485699,
+	.config_ctl_hi_val = 0x00002261,
+	.config_ctl_hi1_val = 0x329a699c,
+	.user_ctl_val = 0x00000001,
+	.user_ctl_hi_val = 0x00000805,
+	.user_ctl_hi1_val = 0x00000000,
+	.test_ctl_hi1_val = 0x01800000,
+};
+
 static struct clk_alpha_pll gpu_cc_pll1 = {
 	.offset = 0x100,
 	.vco_table = lucid_vco,
@@ -295,7 +309,8 @@ static const struct qcom_cc_desc gpu_cc_sm8250_desc = {
 };
 
 static const struct of_device_id gpu_cc_sm8250_match_table[] = {
-	{ .compatible = "qcom,sm8250-gpucc" },
+	{ .compatible = "qcom,sm7250-gpucc", .data = &sm7250_gpu_cc_pll1_config },
+	{ .compatible = "qcom,sm8250-gpucc", .data = &gpu_cc_pll1_config },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, gpu_cc_sm8250_match_table);
@@ -309,7 +324,7 @@ static int gpu_cc_sm8250_probe(struct platform_device *pdev)
 	if (IS_ERR(regmap))
 		return PTR_ERR(regmap);
 
-	clk_lucid_pll_configure(&gpu_cc_pll1, regmap, &gpu_cc_pll1_config);
+	clk_lucid_pll_configure(&gpu_cc_pll1, regmap, device_get_match_data(&pdev->dev));
 
 	/*
 	 * Configure gpu_cc_cx_gmu_clk with recommended
-- 
