index 000000000..d4ae82010
--- /dev/null
+++ b/drivers/power/supply/qcom_qg.c
@@ -0,0 +1,420 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm QGauge (QG) fuel gauge, as found in PM7250B
+ *
+ * The QG block only measures battery voltage and current; the state of charge
+ * has to be worked out in software. This driver does not reprogram the block:
+ * it relies on the configuration left by the bootloader, reads the battery
+ * voltage and current, and estimates the state of charge by
+ *
+ *  - picking an initial value from the shutdown state the downstream driver
+ *    leaves in the QG SDAM, or else from the resistance-compensated open
+ *    circuit voltage and the battery's ocv-capacity tables,
+ *  - counting charge with the measured current, and
+ *  - slowly pulling the count towards the voltage estimate while the current
+ *    is low enough for that estimate to be trustworthy.
+ *
+ * Register layout and conversion factors are from the downstream qpnp-qg
+ * driver (Copyright (c) 2018-2020 The Linux Foundation).
+ */
+
+#include <linux/bits.h>
+#include <linux/devm-helpers.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/timekeeping.h>
+#include <linux/workqueue.h>
+
+#define QG_PERPH_TYPE			0x04
+#define QG_PERPH_SUBTYPE		0x05
+#define QG_TYPE				0x0d
+#define QG_SUBTYPE_IBAT_5A		0x03
+
+#define QG_STATUS1			0x08
+#define QG_STATUS1_OK			BIT(7)
+#define QG_STATUS1_BATT_PRESENT		BIT(0)
+
+#define QG_S7_PON_OCV_V			0x70
+#define QG_LAST_ADC_V			0xc0
+#define QG_LAST_BURST_AVG_I		0xc6
+
+#define QG_FIFO_RESET_VAL		0x8000	/* unset S7 PON OCV */
+
+/* Shutdown state stored by the downstream driver, relative to the SDAM base */
+#define QG_SDAM_VALID			0x46
+#define QG_SDAM_SOC			0x47
+#define QG_SDAM_RBAT			0x4a	/* mOhm, 16 bit */
+#define QG_SDAM_OCV			0x4c	/* uV, 32 bit */
+
+#define QG_POLL_MS			10000
+/* Trust the voltage estimate when the battery current is below this */
+#define QG_REST_CURRENT_UA		150000
+/* Fraction of the gap to the voltage estimate closed per rested sample */
+#define QG_REST_PULL_DIV		30
+/* Shutdown SOC is used if it is this close to the voltage estimate */
+#define QG_SDAM_MAX_DIFF_PCT		10
+/* Used when neither the SDAM nor the battery node give a resistance */
+#define QG_DEFAULT_RBAT_UOHM		100000
+/* No battery temperature input yet */
+#define QG_ASSUMED_TEMP_C		25
+
+struct qcom_qg {
+	struct device *dev;
+	struct regmap *regmap;
+	u32 base;
+	u32 sdam;
+	bool ibat_5a;
+
+	struct power_supply *psy;
+	struct power_supply_battery_info *info;
+	struct delayed_work work;
+	struct mutex lock;
+
+	int rbat_uohm;
+	int full_uah;
+	int vbat_uv;
+	int ibat_ua;			/* positive while charging */
+	int ocv_uv;
+	s64 charge_uah;
+	ktime_t last_sample;
+};
+
+static int qcom_qg_read16(struct qcom_qg *qg, u32 addr, u16 *val)
+{
+	__le16 raw;
+	int ret;
+
+	ret = regmap_bulk_read(qg->regmap, addr, &raw, sizeof(raw));
+	if (ret)
+		return ret;
+
+	*val = le16_to_cpu(raw);
+	return 0;
+}
+
+static int qcom_qg_raw_to_uv(u16 raw)
+{
+	return div_u64(194637ULL * raw, 1000);
+}
+
+/* The hardware reports discharge current as positive */
+static int qcom_qg_raw_to_ua(struct qcom_qg *qg, u16 raw)
+{
+	s64 ua = (s64)sign_extend32(raw, 15) * (qg->ibat_5a ? 152588 : 305176);
+
+	return -div_s64(ua, 1000);
+}
+
+/*
+ * Use the latest ADC voltage and burst-averaged current, as the downstream
+ * driver does for its "now" values: the S2 FIFO averages only update when
+ * the FIFO completes, which can take minutes while the bootloader's
+ * configuration is in place.
+ */
+static int qcom_qg_read_vi(struct qcom_qg *qg)
+{
+	u16 v, i;
+	int ret;
+
+	ret = qcom_qg_read16(qg, qg->base + QG_LAST_ADC_V, &v);
+	if (!ret)
+		ret = qcom_qg_read16(qg, qg->base + QG_LAST_BURST_AVG_I, &i);
+	if (ret)
+		return ret;
+
+	qg->vbat_uv = qcom_qg_raw_to_uv(v);
+	qg->ibat_ua = qcom_qg_raw_to_ua(qg, i);
+	qg->ocv_uv = qg->vbat_uv - div_s64((s64)qg->ibat_ua * qg->rbat_uohm, 1000000);
+
+	return 0;
+}
+
+static int qcom_qg_ocv_to_pct(struct qcom_qg *qg, int ocv_uv)
+{
+	int pct = power_supply_batinfo_ocv2cap(qg->info, ocv_uv, QG_ASSUMED_TEMP_C);
+
+	return clamp(pct, 0, 100);
+}
+
+static int qcom_qg_supplier_status(struct qcom_qg *qg)
+{
+	union power_supply_propval val;
+	int ret;
+
+	ret = power_supply_get_property_from_supplier(qg->psy, POWER_SUPPLY_PROP_STATUS, &val);
+	if (!ret)
+		return val.intval;
+
+	return power_supply_am_i_supplied(qg->psy) > 0 ? POWER_SUPPLY_STATUS_CHARGING :
+							 POWER_SUPPLY_STATUS_DISCHARGING;
+}
+
+static void qcom_qg_update(struct qcom_qg *qg)
+{
+	ktime_t now = ktime_get_boottime();
+	s64 dt_ms, target;
+	int ret;
+
+	ret = qcom_qg_read_vi(qg);
+	if (ret) {
+		dev_err_ratelimited(qg->dev, "failed to read V/I: %d\n", ret);
+		return;
+	}
+
+	dt_ms = ktime_ms_delta(now, qg->last_sample);
+	qg->last_sample = now;
+	qg->charge_uah += div_s64((s64)qg->ibat_ua * dt_ms, 3600 * 1000);
+
+	if (qcom_qg_supplier_status(qg) == POWER_SUPPLY_STATUS_FULL) {
+		qg->charge_uah = qg->full_uah;
+	} else if (abs(qg->ibat_ua) < QG_REST_CURRENT_UA) {
+		target = div_s64((s64)qcom_qg_ocv_to_pct(qg, qg->ocv_uv) * qg->full_uah, 100);
+		qg->charge_uah += div_s64(target - qg->charge_uah, QG_REST_PULL_DIV);
+	}
+
+	if (qg->info->voltage_min_design_uv > 0 &&
+	    qg->vbat_uv < qg->info->voltage_min_design_uv)
+		qg->charge_uah = 0;
+
+	qg->charge_uah = clamp_t(s64, qg->charge_uah, 0, qg->full_uah);
+}
+
+static int qcom_qg_capacity(struct qcom_qg *qg)
+{
+	return DIV_ROUND_CLOSEST_ULL(qg->charge_uah * 100, qg->full_uah);
+}
+
+static void qcom_qg_work(struct work_struct *work)
+{
+	struct qcom_qg *qg = container_of(work, struct qcom_qg, work.work);
+	int old;
+
+	mutex_lock(&qg->lock);
+	old = qcom_qg_capacity(qg);
+	qcom_qg_update(qg);
+	mutex_unlock(&qg->lock);
+
+	if (qcom_qg_capacity(qg) != old)
+		power_supply_changed(qg->psy);
+
+	schedule_delayed_work(&qg->work, msecs_to_jiffies(QG_POLL_MS));
+}
+
+static int qcom_qg_get_property(struct power_supply *psy,
+				enum power_supply_property psp,
+				union power_supply_propval *val)
+{
+	struct qcom_qg *qg = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	mutex_lock(&qg->lock);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = qcom_qg_supplier_status(qg);
+		if (val->intval == POWER_SUPPLY_STATUS_UNKNOWN)
+			val->intval = qg->ibat_ua > 0 ? POWER_SUPPLY_STATUS_CHARGING :
+							POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_SYSTEM;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = qg->vbat_uv;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		val->intval = qg->ocv_uv;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		val->intval = qg->ibat_ua;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = qcom_qg_capacity(qg);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		val->intval = qg->charge_uah;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = qg->full_uah;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = qg->info->voltage_min_design_uv;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+
+	mutex_unlock(&qg->lock);
+
+	return ret;
+}
+
+static const enum power_supply_property qcom_qg_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_SCOPE,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+};
+
+static const struct power_supply_desc qcom_qg_desc = {
+	.name = "qcom-qg",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = qcom_qg_props,
+	.num_properties = ARRAY_SIZE(qcom_qg_props),
+	.get_property = qcom_qg_get_property,
+};
+
+/*
+ * Pick the starting state of charge. The downstream driver keeps its last SOC,
+ * OCV and battery resistance in the SDAM; use them when they agree with what
+ * the voltage says, since without an RTC we cannot tell how old they are.
+ */
+static void qcom_qg_init_soc(struct qcom_qg *qg)
+{
+	u8 valid = 0, soc = 0;
+	u16 rbat_mohm = 0, pon_raw = 0;
+	__le32 sdam_ocv = 0;
+	int v_pct, pct, pon_uv;
+	bool use_sdam = false;
+
+	if (qg->sdam) {
+		regmap_raw_read(qg->regmap, qg->sdam + QG_SDAM_VALID, &valid, 1);
+		regmap_raw_read(qg->regmap, qg->sdam + QG_SDAM_SOC, &soc, 1);
+		qcom_qg_read16(qg, qg->sdam + QG_SDAM_RBAT, &rbat_mohm);
+		regmap_raw_read(qg->regmap, qg->sdam + QG_SDAM_OCV, &sdam_ocv, 4);
+	}
+
+	if (!qg->rbat_uohm && valid == 1 && rbat_mohm >= 30 && rbat_mohm <= 500)
+		qg->rbat_uohm = rbat_mohm * 1000;
+	if (!qg->rbat_uohm)
+		qg->rbat_uohm = QG_DEFAULT_RBAT_UOHM;
+
+	qcom_qg_read_vi(qg);
+	v_pct = qcom_qg_ocv_to_pct(qg, qg->ocv_uv);
+
+	if (valid == 1 && soc <= 100 && abs(soc - v_pct) <= QG_SDAM_MAX_DIFF_PCT)
+		use_sdam = true;
+	pct = use_sdam ? soc : v_pct;
+
+	qcom_qg_read16(qg, qg->base + QG_S7_PON_OCV_V, &pon_raw);
+	pon_uv = qcom_qg_raw_to_uv(pon_raw);
+
+	dev_info(qg->dev,
+		 "V=%duV I=%duA Rbat=%duOhm OCV=%duV (%d%%), PON OCV=%duV (%d%%), SDAM valid=%u SOC=%u%% OCV=%uuV Rbat=%umOhm; starting at %d%% (%s)\n",
+		 qg->vbat_uv, qg->ibat_ua, qg->rbat_uohm, qg->ocv_uv, v_pct,
+		 pon_uv, pon_raw && pon_raw != QG_FIFO_RESET_VAL ? qcom_qg_ocv_to_pct(qg, pon_uv) : -1,
+		 valid, soc, le32_to_cpu(sdam_ocv), rbat_mohm, pct,
+		 use_sdam ? "SDAM" : "voltage");
+
+	qg->charge_uah = div_s64((s64)pct * qg->full_uah, 100);
+	qg->last_sample = ktime_get_boottime();
+}
+
+static int qcom_qg_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config cfg = {};
+	struct qcom_qg *qg;
+	u32 reg[2] = {};
+	u8 type, subtype, status;
+	int ret;
+
+	qg = devm_kzalloc(dev, sizeof(*qg), GFP_KERNEL);
+	if (!qg)
+		return -ENOMEM;
+
+	qg->dev = dev;
+	mutex_init(&qg->lock);
+
+	qg->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!qg->regmap)
+		return -ENODEV;
+
+	ret = device_property_count_u32(dev, "reg");
+	if (ret < 1 || ret > 2)
+		return dev_err_probe(dev, -EINVAL, "invalid reg\n");
+	device_property_read_u32_array(dev, "reg", reg, ret);
+	qg->base = reg[0];
+	qg->sdam = reg[1];
+
+	ret = regmap_raw_read(qg->regmap, qg->base + QG_PERPH_TYPE, &type, 1);
+	if (!ret)
+		ret = regmap_raw_read(qg->regmap, qg->base + QG_PERPH_SUBTYPE, &subtype, 1);
+	if (!ret)
+		ret = regmap_raw_read(qg->regmap, qg->base + QG_STATUS1, &status, 1);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to access QG\n");
+
+	if (type != QG_TYPE)
+		return dev_err_probe(dev, -ENODEV, "unexpected peripheral type %#x\n", type);
+	qg->ibat_5a = subtype == QG_SUBTYPE_IBAT_5A;
+
+	if (!(status & QG_STATUS1_OK))
+		dev_warn(dev, "QG not ready (status1 %#x)\n", status);
+	if (!(status & QG_STATUS1_BATT_PRESENT))
+		dev_warn(dev, "no battery detected (status1 %#x)\n", status);
+
+	cfg.drv_data = qg;
+	cfg.fwnode = dev_fwnode(dev);
+	qg->psy = devm_power_supply_register(dev, &qcom_qg_desc, &cfg);
+	if (IS_ERR(qg->psy))
+		return dev_err_probe(dev, PTR_ERR(qg->psy), "failed to register battery\n");
+
+	ret = power_supply_get_battery_info(qg->psy, &qg->info);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get battery info\n");
+	if (qg->info->charge_full_design_uah <= 0 || !qg->info->ocv_table_size[0])
+		return dev_err_probe(dev, -EINVAL,
+				     "battery needs a design capacity and ocv-capacity tables\n");
+
+	qg->full_uah = qg->info->charge_full_design_uah;
+	if (qg->info->factory_internal_resistance_uohm > 0)
+		qg->rbat_uohm = qg->info->factory_internal_resistance_uohm;
+
+	qcom_qg_init_soc(qg);
+
+	ret = devm_delayed_work_autocancel(dev, &qg->work, qcom_qg_work);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&qg->work, msecs_to_jiffies(QG_POLL_MS));
+
+	return 0;
+}
+
+static const struct of_device_id qcom_qg_of_match[] = {
+	{ .compatible = "qcom,pm7250b-qg" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qcom_qg_of_match);
+
+static struct platform_driver qcom_qg_driver = {
+	.driver = {
+		.name = "qcom-qg",
+		.of_match_table = qcom_qg_of_match,
+	},
+	.probe = qcom_qg_probe,
+};
+module_platform_driver(qcom_qg_driver);
+
+MODULE_DESCRIPTION("Qualcomm QGauge fuel gauge driver");
+MODULE_LICENSE("GPL");
-- 
