From 50f7c37b144933bbdef848e3dfef6de0c30c67e0 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Mon, 5 Oct 2026 17:03:11 +0100
Subject: [PATCH 44/69] drm/sysfb: simpledrm: Control the panel backlight

When the framebuffer node references a backlight, turn it off and on
together with the CRTC. Without this, blanking the display only paints
the framebuffer black and the panel stays lit.

A linked backlight also means the framebuffer is on a built-in panel, so
report the connector as DSI instead of Unknown: compositors such as KWin
only manage the brightness of connectors they consider internal.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/gpu/drm/sysfb/Kconfig     |  1 +
 drivers/gpu/drm/sysfb/simpledrm.c | 30 +++++++++++++++++++++++++++++-
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/sysfb/Kconfig b/drivers/gpu/drm/sysfb/Kconfig
index f7e481788..b078c68e3 100644
--- a/drivers/gpu/drm/sysfb/Kconfig
+++ b/drivers/gpu/drm/sysfb/Kconfig
@@ -57,6 +57,7 @@ config DRM_OFDRM
 config DRM_SIMPLEDRM
 	tristate "Simple framebuffer driver"
 	depends on DRM && MMU
+	depends on BACKLIGHT_CLASS_DEVICE || !BACKLIGHT_CLASS_DEVICE
 	select APERTURE_HELPERS
 	select DRM_CLIENT_SELECTION
 	select DRM_GEM_SHMEM_HELPER
diff --git a/drivers/gpu/drm/sysfb/simpledrm.c b/drivers/gpu/drm/sysfb/simpledrm.c
index 21ddf4502..c566ffbed 100644
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include <linux/aperture.h>
+#include <linux/backlight.h>
 #include <linux/clk.h>
 #include <linux/minmax.h>
 #include <linux/of_address.h>
@@ -244,6 +245,8 @@ struct simpledrm_device {
 	struct device **pwr_dom_devs;
 	struct device_link **pwr_dom_links;
 #endif
+	/* backlight of the panel the firmware set up, if described */
+	struct backlight_device *backlight;
 
 	/* modesetting */
 	u32 formats[DRM_SYSFB_PLANE_NFORMATS(1)];
@@ -583,8 +586,26 @@ static const struct drm_plane_funcs simpledrm_primary_plane_funcs = {
 	.destroy = drm_plane_cleanup,
 };
 
+static void simpledrm_crtc_helper_atomic_enable(struct drm_crtc *crtc,
+						struct drm_atomic_commit *state)
+{
+	struct simpledrm_device *sdev = container_of(crtc, struct simpledrm_device, crtc);
+
+	backlight_enable(sdev->backlight);
+}
+
+static void simpledrm_crtc_helper_atomic_disable(struct drm_crtc *crtc,
+						 struct drm_atomic_commit *state)
+{
+	struct simpledrm_device *sdev = container_of(crtc, struct simpledrm_device, crtc);
+
+	backlight_disable(sdev->backlight);
+}
+
 static const struct drm_crtc_helper_funcs simpledrm_crtc_helper_funcs = {
 	DRM_SYSFB_CRTC_HELPER_FUNCS,
+	.atomic_enable = simpledrm_crtc_helper_atomic_enable,
+	.atomic_disable = simpledrm_crtc_helper_atomic_disable,
 };
 
 static const struct drm_crtc_funcs simpledrm_crtc_funcs = {
@@ -656,6 +677,11 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 	ret = simpledrm_device_attach_genpd(sdev);
 	if (ret)
 		return ERR_PTR(ret);
+	if (of_node) {
+		sdev->backlight = devm_of_find_backlight(&pdev->dev);
+		if (IS_ERR(sdev->backlight))
+			return ERR_CAST(sdev->backlight);
+	}
 
 	if (pd) {
 		width = simplefb_get_width_pd(dev, pd);
@@ -864,8 +890,10 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 	/* Connector */
 
 	connector = &sdev->connector;
+	/* a linked backlight means a built-in panel, which compositors want to know */
 	ret = drm_connector_init(dev, connector, &simpledrm_connector_funcs,
-				 DRM_MODE_CONNECTOR_Unknown);
+				 sdev->backlight ? DRM_MODE_CONNECTOR_DSI :
+						   DRM_MODE_CONNECTOR_Unknown);
 	if (ret)
 		return ERR_PTR(ret);
 	drm_connector_helper_add(connector, &simpledrm_connector_helper_funcs);
