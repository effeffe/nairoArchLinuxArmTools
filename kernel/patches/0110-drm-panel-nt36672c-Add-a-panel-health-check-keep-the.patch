From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 11 Oct 2026 00:52:22 +0100
Subject: [PATCH 110/113] drm/panel: nt36672c: Add a panel health check, keep
 the brightness level

Poll the power mode every 5 s while the panel is enabled, as the
downstream ESD check does (DCS 0x0a in LP mode, expect 0x9c), and
power-cycle the panel through drm_panel_unprepare/prepare after two bad
reads, so that the touch controller following the panel is
reinitialized too.

The bootloader leaves the panel brightness register at its maximum,
which downstream only uses as high brightness mode. Set the normal level
of the init sequence (51 cc) at handoff, so that the first re-init
(mode switch, screen off and on) doesn't dim the screen.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 .../gpu/drm/panel/panel-novatek-nt36672c.c    | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36672c.c b/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
index 67c2ed947..bd6abded0 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672c.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
 
 #include <video/mipi_display.h>
 
@@ -28,8 +29,15 @@ struct nt36672c {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
 	bool handoff;
+	struct delayed_work esd_work;
+	unsigned int esd_failures;
 };
 
+/* As downstream: read the power mode in LP mode, expect booster/sleep out/normal/display on */
+#define NT36672C_ESD_PERIOD_MS		5000
+#define NT36672C_ESD_POWER_MODE		0x9c
+#define NT36672C_ESD_MAX_FAILURES	2
+
 /* In power-up order */
 static const struct regulator_bulk_data nt36672c_supplies[] = {
 	{ .supply = "vddio" }, /* 1.8 V */
@@ -139,8 +147,19 @@ static int nt36672c_prepare(struct drm_panel *panel)
 	 * the touch controller of this TDDI chip.
 	 */
 	if (ctx->handoff) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
 		ctx->handoff = false;
 		dev_info(dev, "keeping the panel state from the bootloader\n");
+
+		/*
+		 * The bootloader leaves the panel brightness at its maximum (the
+		 * downstream high brightness mode): use the normal level of the
+		 * init sequence, so that a later re-init doesn't dim the screen.
+		 */
+		ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0xcc);
+		ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 		return 0;
 	}
 
@@ -231,9 +250,62 @@ static int nt36672c_get_modes(struct drm_panel *panel,
 	return ARRAY_SIZE(nt36672c_tianma_modes);
 }
 
+/*
+ * Panel health check: an ESD event can leave the panel blank while the DSI
+ * link keeps running. Poll the power mode like the downstream driver does,
+ * and power-cycle the panel when it is wrong twice in a row. The cycle goes
+ * through drm_panel_unprepare/prepare, so the touch controller (a panel
+ * follower) is reinitialized with it.
+ */
+static void nt36672c_esd_work(struct work_struct *work)
+{
+	struct nt36672c *ctx = container_of(to_delayed_work(work),
+					    struct nt36672c, esd_work);
+	struct device *dev = &ctx->dsi->dev;
+	u8 mode = 0;
+	int ret;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &mode);
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	if (!ret && mode == NT36672C_ESD_POWER_MODE) {
+		ctx->esd_failures = 0;
+	} else if (++ctx->esd_failures >= NT36672C_ESD_MAX_FAILURES) {
+		dev_warn(dev, "panel not responding (ret %d, power mode 0x%02x): resetting it\n",
+			 ret, mode);
+		ctx->esd_failures = 0;
+		drm_panel_unprepare(&ctx->panel);
+		drm_panel_prepare(&ctx->panel);
+	}
+
+	schedule_delayed_work(&ctx->esd_work, msecs_to_jiffies(NT36672C_ESD_PERIOD_MS));
+}
+
+static int nt36672c_enable(struct drm_panel *panel)
+{
+	struct nt36672c *ctx = to_nt36672c(panel);
+
+	ctx->esd_failures = 0;
+	schedule_delayed_work(&ctx->esd_work, msecs_to_jiffies(NT36672C_ESD_PERIOD_MS));
+
+	return 0;
+}
+
+static int nt36672c_disable(struct drm_panel *panel)
+{
+	struct nt36672c *ctx = to_nt36672c(panel);
+
+	cancel_delayed_work_sync(&ctx->esd_work);
+
+	return 0;
+}
+
 static const struct drm_panel_funcs nt36672c_panel_funcs = {
 	.prepare = nt36672c_prepare,
 	.unprepare = nt36672c_unprepare,
+	.enable = nt36672c_enable,
+	.disable = nt36672c_disable,
 	.get_modes = nt36672c_get_modes,
 };
 
@@ -265,6 +337,7 @@ static int nt36672c_probe(struct mipi_dsi_device *dsi)
 
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
+	INIT_DELAYED_WORK(&ctx->esd_work, nt36672c_esd_work);
 
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
