From 3dbef723bdd449b5316dda1e6b286d8b3ddfdd7e Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Wed, 7 Oct 2026 13:33:10 +0100
Subject: [PATCH 64/69] LOCAL: scsi: ufs: qcom: Keep the link active on SM7250

The SM7250 link failed to leave Hibern8 (PWR_FATAL) and the PHY then
never initialised again. Disable clock gating, auto-Hibern8 and runtime
suspend of the host for SM7250 and use runtime PM level 0.

The underlying cause turned out to be the unvoted qphy rail (see the
rpmhpd change); with it voted this may no longer be needed, so retest
Hibern8 and drop this workaround if it holds.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/ufs/host/ufs-qcom.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index e7e1c004c..7e54e790c 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -16,6 +16,7 @@
 #include <linux/of.h>
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/pm_domain.h>
 #include <linux/reset-controller.h>
 #include <linux/time.h>
@@ -1451,6 +1452,20 @@ static void ufs_qcom_set_caps(struct ufs_hba *hba)
 	if (host->hw_ver.major >= 0x7)
 		hba->caps |= UFSHCD_CAP_TX_EQUALIZATION;
 
+	/*
+	 * On SM7250 the link sometimes fails to leave Hibern8 (PWR_FATAL)
+	 * and the PHY then never completes initialisation again, losing the
+	 * storage until reboot. Keep the link active: no clock gating, no
+	 * auto-Hibern8, and runtime PM level 0 (device and link active).
+	 */
+	if (of_device_is_compatible(hba->dev->of_node, "qcom,sm7250-ufshc")) {
+		hba->caps &= ~(UFSHCD_CAP_CLK_GATING |
+			       UFSHCD_CAP_HIBERN8_WITH_CLK_GATING |
+			       UFSHCD_CAP_RPM_AUTOSUSPEND);
+		hba->quirks |= UFSHCD_QUIRK_BROKEN_AUTO_HIBERN8;
+		hba->rpm_lvl = UFS_PM_LVL_0;
+	}
+
 	ufs_qcom_set_host_caps(hba);
 }
 
@@ -3031,6 +3046,10 @@ static int ufs_qcom_probe(struct platform_device *pdev)
 	if (err)
 		return dev_err_probe(dev, err, "ufshcd_pltfrm_init() failed\n");
 
+	/* SM7250: a runtime-suspended host gates the clocks under an active link */
+	if (of_device_is_compatible(dev->of_node, "qcom,sm7250-ufshc"))
+		pm_runtime_forbid(dev);
+
 	return 0;
 }
 
