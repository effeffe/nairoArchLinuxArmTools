From 656683008cbf2e408a4240fe984b67fd6abda541 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 4 Oct 2026 16:28:20 +0100
Subject: [PATCH 21/69] arm64: dts: qcom: sm7250: Fix cluster idle-state PSCI
 parameters

The downstream lito devicetree uses modes 0x224 and 0xc24 for the cluster
power-collapse states, i.e. PSCI parameters 0x41002244 and 0x4100c244, not
0x41001244 and 0x4100b244.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index 48480e685..1261ff563 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -275,7 +275,7 @@ cluster_sleep_pc: cluster-sleep-0 {
 
 			cluster_sleep_cx: cluster-sleep-1 {
 				compatible = "domain-idle-state";
-				arm,psci-suspend-param = <0x41001244>;
+				arm,psci-suspend-param = <0x41002244>;
 				entry-latency-us = <3638>;
 				exit-latency-us = <4562>;
 				min-residency-us = <8467>;
@@ -283,7 +283,7 @@ cluster_sleep_cx: cluster-sleep-1 {
 
 			cluster_sleep_aoss: cluster-sleep-2 {
 				compatible = "domain-idle-state";
-				arm,psci-suspend-param = <0x4100b244>;
+				arm,psci-suspend-param = <0x4100c244>;
 				entry-latency-us = <3263>;
 				exit-latency-us = <6562>;
 				min-residency-us = <9826>;
