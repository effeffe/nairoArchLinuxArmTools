From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sat, 10 Oct 2026 23:13:21 +0100
Subject: [PATCH 089/102] clk: qcom: dispcc-sm8250: Add SM7250 support

All clocks SM7250 shares with SM8250 sit at the same offsets. SM7250
has no PLL1: the mux input it uses on SM8250 carries GCC's GPLL0
display branch (600 MHz, like PLL1), so the frequency tables still
apply. Drop the second DP link, DP pixel 2 and eDP clocks, and use the
downstream PLL0 user and test control values.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 drivers/clk/qcom/Kconfig         |  6 +--
 drivers/clk/qcom/dispcc-sm8250.c | 76 +++++++++++++++++++++++++++++++-
 2 files changed, 77 insertions(+), 5 deletions(-)

diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index e425b93d4..5cf598c3a 100644
--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -1610,13 +1610,13 @@ config SM_DISPCC_7150
 	  splash screen.
 
 config SM_DISPCC_8250
-	tristate "SM8150/SM8250/SM8350 Display Clock Controller"
+	tristate "SM7250/SM8150/SM8250/SM8350 Display Clock Controller"
 	depends on ARM64 || COMPILE_TEST
-	depends on SM_GCC_8150 || SM_GCC_8250 || SM_GCC_8350
+	depends on SM_GCC_7250 || SM_GCC_8150 || SM_GCC_8250 || SM_GCC_8350
 	default m if ARCH_QCOM
 	help
 	  Support for the display clock controller on Qualcomm Technologies, Inc
-	  SM8150/SM8250/SM8350 devices.
+	  SM7250/SM8150/SM8250/SM8350 devices.
 	  Say Y if you want to support display devices and functionality such as
 	  splash screen.
 
diff --git a/drivers/clk/qcom/dispcc-sm8250.c b/drivers/clk/qcom/dispcc-sm8250.c
index dc62eb18d..c1b3bb92a 100644
--- a/drivers/clk/qcom/dispcc-sm8250.c
+++ b/drivers/clk/qcom/dispcc-sm8250.c
@@ -620,6 +620,45 @@ static struct clk_rcg2 disp_cc_mdss_rot_clk_src = {
 	},
 };
 
+/*
+ * SM7250 has no display PLL1: mux input 4 carries the GPLL0 display branch
+ * from GCC instead, also at 600 MHz, so the frequency tables still apply.
+ */
+static const struct clk_parent_data disp_cc_parent_data_3_sm7250[] = {
+	{ .fw_name = "bi_tcxo" },
+	{ .fw_name = "gcc_disp_gpll0_clk_src" },
+};
+
+static const struct clk_parent_data disp_cc_parent_data_5_sm7250[] = {
+	{ .fw_name = "bi_tcxo" },
+	{ .hw = &disp_cc_pll0.clkr.hw },
+	{ .fw_name = "gcc_disp_gpll0_clk_src" },
+};
+
+static const struct clk_init_data disp_cc_mdss_ahb_clk_src_init_sm7250 = {
+	.name = "disp_cc_mdss_ahb_clk_src",
+	.parent_data = disp_cc_parent_data_3_sm7250,
+	.num_parents = ARRAY_SIZE(disp_cc_parent_data_3_sm7250),
+	.flags = CLK_SET_RATE_PARENT,
+	.ops = &clk_rcg2_shared_ops,
+};
+
+static const struct clk_init_data disp_cc_mdss_mdp_clk_src_init_sm7250 = {
+	.name = "disp_cc_mdss_mdp_clk_src",
+	.parent_data = disp_cc_parent_data_5_sm7250,
+	.num_parents = ARRAY_SIZE(disp_cc_parent_data_5_sm7250),
+	.flags = CLK_SET_RATE_PARENT,
+	.ops = &clk_rcg2_shared_ops,
+};
+
+static const struct clk_init_data disp_cc_mdss_rot_clk_src_init_sm7250 = {
+	.name = "disp_cc_mdss_rot_clk_src",
+	.parent_data = disp_cc_parent_data_5_sm7250,
+	.num_parents = ARRAY_SIZE(disp_cc_parent_data_5_sm7250),
+	.flags = CLK_SET_RATE_PARENT,
+	.ops = &clk_rcg2_shared_ops,
+};
+
 static struct clk_rcg2 disp_cc_mdss_vsync_clk_src = {
 	.cmd_rcgr = 0x20f8,
 	.mnd_width = 0,
@@ -1254,6 +1293,7 @@ static const struct qcom_cc_desc disp_cc_sm8250_desc = {
 
 static const struct of_device_id disp_cc_sm8250_match_table[] = {
 	{ .compatible = "qcom,sc8180x-dispcc" },
+	{ .compatible = "qcom,sm7250-dispcc" },
 	{ .compatible = "qcom,sm8150-dispcc" },
 	{ .compatible = "qcom,sm8250-dispcc" },
 	{ .compatible = "qcom,sm8350-dispcc" },
@@ -1280,7 +1320,7 @@ static int disp_cc_sm8250_probe(struct platform_device *pdev)
 		return PTR_ERR(regmap);
 	}
 
-	/* Apply differences for SM8150 and SM8350 */
+	/* Apply differences for SM7250, SM8150 and SM8350 */
 	BUILD_BUG_ON(CLK_ALPHA_PLL_TYPE_TRION != CLK_ALPHA_PLL_TYPE_LUCID);
 	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sc8180x-dispcc") ||
 	    of_device_is_compatible(pdev->dev.of_node, "qcom,sm8150-dispcc")) {
@@ -1369,7 +1409,39 @@ static int disp_cc_sm8250_probe(struct platform_device *pdev)
 		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_GTC_CLK_SRC] = NULL;
 	}
 
-	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm8350-dispcc")) {
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm7250-dispcc")) {
+		disp_cc_pll0_config.user_ctl_val = 0x00000001;
+		disp_cc_pll0_config.test_ctl_hi1_val = 0x01800000;
+
+		disp_cc_mdss_ahb_clk_src.clkr.hw.init = &disp_cc_mdss_ahb_clk_src_init_sm7250;
+		disp_cc_mdss_mdp_clk_src.clkr.hw.init = &disp_cc_mdss_mdp_clk_src_init_sm7250;
+		disp_cc_mdss_rot_clk_src.clkr.hw.init = &disp_cc_mdss_rot_clk_src_init_sm7250;
+
+		/* No PLL1, second DP link or eDP */
+		disp_cc_sm8250_clocks[DISP_CC_PLL1] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_AUX1_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_AUX1_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_LINK1_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_LINK1_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_LINK1_DIV_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_LINK1_INTF_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_PIXEL2_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_DP_PIXEL2_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_AUX_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_AUX_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_GTC_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_GTC_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_LINK_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_LINK_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_LINK_DIV_CLK_SRC] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_LINK_INTF_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_PIXEL_CLK] = NULL;
+		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_PIXEL_CLK_SRC] = NULL;
+	}
+
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm7250-dispcc")) {
+		clk_lucid_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
+	} else if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm8350-dispcc")) {
 		clk_lucid_5lpe_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
 		clk_lucid_5lpe_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
 	} else {
