+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Motorola Moto G 5G Plus (XT2075-3, nairo)
+ *
+ * Hardware values taken from the downstream device tree the bootloader hands
+ * to the LineageOS 4.19 kernel (lito-moto-base + lito-nairo-pvt overlay).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/arm/qcom,ids.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+#include "sm7250.dtsi"
+#include "pm8150.dtsi"
+#include "pm8150l.dtsi"
+/* live DT: qcom,pm7250b@2 and @3 */
+#define PM7250B_SID 2
+#define PM7250B_SID1 3
+#include "pm7250b.dtsi"
+#include "sm7250-motorola-nairo-dtbo-sink.dtsi"
+
+/ {
+	/*
+	 * The bootloader only accepts a DTB whose model matches this string
+	 * (case-insensitive), so the board name lives in compatible only.
+	 */
+	model = "Qualcomm Technologies, Inc. Lito";
+	compatible = "motorola,nairo", "qcom,sm7250";
+	chassis-type = "handset";
+
+	/* Same IDs as the stock base DTB, so ABL picks this DTB */
+	qcom,msm-id = <QCOM_ID_SM7250 0x10000>, <440 0x10000>;
+	qcom,board-id = <0 0>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * Bootloader splash buffer on the 1080x2520 Tianma NT36672C panel.
+		 * TODO: pixel format/stride unconfirmed; a8r8g8b8 matches what
+		 * Motorola ABL uses on sm7325-motorola-dubai. Try r8g8b8 with a
+		 * stride of 1080 * 3 if the console is skewed.
+		 */
+		framebuffer0: framebuffer@a0000000 {
+			compatible = "simple-framebuffer";
+			memory-region = <&cont_splash_mem>;
+			width = <1080>;
+			height = <2520>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_n>, <&google_key_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			gpios = <&pm8150l_gpios 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+
+		/* Labelled "google_key" downstream, mapped to KEY_SEARCH there */
+		key-google {
+			label = "Google Key";
+			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_SEARCH>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * LZ50 5000 mAh (Amperex or Scud cells; downstream battery profiles:
+	 * 4.45 V max, 4 A fast charge). Only the capacity is given for now, so
+	 * the charger keeps the float voltage and charge current the bootloader
+	 * programmed instead of Linux reprogramming them.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <5000000>;
+	};
+
+	/* Bootloader fills in the real banks (~6 GiB) */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x0>;
+	};
+
+	reserved-memory {
+		sec_apps_mem: sec-apps@808ff000 {
+			reg = <0x0 0x808ff000 0x0 0x1000>;
+			no-map;
+		};
+
+		qtee_apps_mem: qtee-apps@81e00000 {
+			reg = <0x0 0x81e00000 0x0 0x4200000>;
+			no-map;
+		};
+
+		pil_reserved_mem: pil-reserved@8bc17400 {
+			reg = <0x0 0x8bc17400 0x0 0x3e8c00>;
+			no-map;
+		};
+
+		cont_splash_mem: cont-splash@a0000000 {
+			reg = <0x0 0xa0000000 0x0 0x2300000>;
+			no-map;
+		};
+
+		dfps_data_mem: dfps-data@a2300000 {
+			reg = <0x0 0xa2300000 0x0 0x100000>;
+			no-map;
+		};
+
+		mmi_annotate_mem: mmi-annotate@aef9d800 {
+			reg = <0x0 0xaef9d800 0x0 0x800>;
+			no-map;
+		};
+
+		tzlog_dump_mem: tzlog-dump@aef9e000 {
+			reg = <0x0 0xaef9e000 0x0 0x30000>;
+			no-map;
+		};
+
+		wdog_cpuctx_mem: wdog-cpuctx@aefce000 {
+			reg = <0x0 0xaefce000 0x0 0x32000>;
+			no-map;
+		};
+
+		/* Same layout as downstream, so LineageOS can read our logs */
+		ramoops@af000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xaf000000 0x0 0xbf800>;
+			record-size = <0x3f800>;
+			console-size = <0x40000>;
+			pmsg-size = <0x40000>;
+			no-map;
+		};
+	};
+};
+
+&apps_rsc {
+	/*
+	 * Only the USB HS PHY and UFS supplies so far. Voltages are fixed points
+	 * inside the downstream ranges (live DT): l2a 2.7-3.3 V, l5a
+	 * 0.72-1.056 V (USB PHY asks 0.88 V), l9a 1.152-1.32 V, l12a
+	 * 1.704-1.89 V, s4a 1.8 V, l7c 2.7-3.3 V (UFS vcc-voltage-level
+	 * 2.952-2.96 V), l6c 1.8-2.96 V (SD I/O), l9c 2.7-3.3 V (SD card,
+	 * downstream asks 2.95 V).
+	 */
+	regulators-0 {
+		compatible = "qcom,pm8150-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		vreg_s4a_1p8: smps4 {
+			regulator-name = "vreg_s4a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			/* main 1.8 V I/O rail */
+			regulator-always-on;
+		};
+
+		vreg_l2a_3p1: ldo2 {
+			regulator-name = "vreg_l2a_3p1";
+			regulator-min-microvolt = <3072000>;
+			regulator-max-microvolt = <3072000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l5a_0p88: ldo5 {
+			regulator-name = "vreg_l5a_0p88";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <880000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l9a_1p2: ldo9 {
+			regulator-name = "vreg_l9a_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l12a_1p8: ldo12 {
+			regulator-name = "vreg_l12a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm8150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		vreg_l6c_2p96: ldo6 {
+			regulator-name = "vreg_l6c_2p96";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l7c_2p96: ldo7 {
+			regulator-name = "vreg_l7c_2p96";
+			regulator-min-microvolt = <2952000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l9c_2p96: ldo9 {
+			regulator-name = "vreg_l9c_2p96";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+&pm7250b_charger {
+	monitored-battery = <&battery>;
+
+	status = "okay";
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+
+	status = "okay";
+};
+
+&pm8150l_gpios {
+	vol_up_n: vol-up-n-state {
+		pins = "gpio5";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		power-source = <0>;
+		bias-pull-up;
+		input-enable;
+	};
+};
+
+&tlmm {
+	/*
+	 * 59-62: QUP1 SE0 SPI (spi@980000), the fingerprint bus, owned by
+	 * TrustZone (disabled in the downstream DT). Touching these pins
+	 * from Linux hangs the bus.
+	 */
+	gpio-reserved-ranges = <59 4>;
+
+	sdc2_card_det_n: sd-card-det-n-state {
+		pins = "gpio69";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	ts_int_default: ts-int-default-state {
+		pins = "gpio11";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	google_key_n: google-key-n-state {
+		pins = "gpio26";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
+
+&sdhc_2 {
+	vmmc-supply = <&vreg_l9c_2p96>;
+	vqmmc-supply = <&vreg_l6c_2p96>;
+
+	cd-gpios = <&tlmm 69 GPIO_ACTIVE_HIGH>;
+
+	pinctrl-0 = <&sdc2_default_state>, <&sdc2_card_det_n>;
+	pinctrl-1 = <&sdc2_sleep_state>, <&sdc2_card_det_n>;
+	pinctrl-names = "default", "sleep";
+
+	status = "okay";
+};
+
+&spi7 {
+	status = "okay";
+
+	/*
+	 * Touch side of the Novatek NT36672C TDDI (Tianma panel). No flash:
+	 * the firmware is downloaded at every power-on. Values from the live
+	 * DT (qupv3_se7_spi/novatek@0); reset is shared with the panel RESX.
+	 */
+	touchscreen@0 {
+		compatible = "novatek,NVT-ts-spi";
+		reg = <0>;
+		spi-max-frequency = <9600000>;
+
+		interrupts-extended = <&tlmm 11 IRQ_TYPE_EDGE_RISING>;
+		pinctrl-0 = <&ts_int_default>;
+		pinctrl-names = "default";
+
+		firmware-name = "novatek/nt36672c-tianma.bin";
+		novatek,swrst-n8-addr = <0x3f0fe>;
+		novatek,spi-rd-fast-addr = <0x3f310>;
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <2520>;
+	};
+};
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;	/* ufs_reset pad */
+
+	vcc-supply = <&vreg_l7c_2p96>;
+	vccq2-supply = <&vreg_s4a_1p8>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+};
+
+&usb_1 {
+	/*
+	 * The port is USB 2.0 only (no SuperSpeed lanes, no DisplayPort), so
+	 * there is no pipe clock: clock the core's PIPE domain from UTMI, like
+	 * downstream dwc3-msm does for high-speed-only configurations.
+	 */
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+&usb_1_hsphy {
+	vdda-pll-supply = <&vreg_l5a_0p88>;
+	vdda18-supply = <&vreg_l12a_1p8>;
+	vdda33-supply = <&vreg_l2a_3p1>;
+
+	status = "okay";
+};
-- 
