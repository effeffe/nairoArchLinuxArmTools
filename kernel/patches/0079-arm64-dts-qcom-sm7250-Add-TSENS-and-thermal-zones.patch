From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sat, 10 Oct 2026 21:08:54 +0100
Subject: [PATCH 79/87] arm64: dts: qcom: sm7250: Add TSENS and thermal zones

Add the two TSENS controllers (same addresses and PDC interrupts as on
SM8250) and a thermal zone for every sensor the downstream device tree
uses, with its names. All zones shut down at 110 C; the two GPU zones
also throttle the GPU from 85 C, as on SM8250.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 529 +++++++++++++++++++++++++++
 1 file changed, 529 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index caf2c5394..f3616e176 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -11,6 +11,7 @@
 #include <dt-bindings/power/qcom,rpmhpd.h>
 #include <dt-bindings/power/qcom-rpmpd.h>
 #include <dt-bindings/soc/qcom,rpmh-rsc.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	interrupt-parent = <&intc>;
@@ -1158,6 +1159,28 @@ pdc: interrupt-controller@b220000 {
 			interrupt-controller;
 		};
 
+		tsens0: thermal-sensor@c263000 {
+			compatible = "qcom,sm7250-tsens", "qcom,tsens-v2";
+			reg = <0x0 0x0c263000 0x0 0x1ff>, /* TM */
+			      <0x0 0x0c222000 0x0 0x1ff>; /* SROT */
+			#qcom,sensors = <15>;
+			interrupts-extended = <&pdc 26 IRQ_TYPE_LEVEL_HIGH>,
+					      <&pdc 28 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "uplow", "critical";
+			#thermal-sensor-cells = <1>;
+		};
+
+		tsens1: thermal-sensor@c265000 {
+			compatible = "qcom,sm7250-tsens", "qcom,tsens-v2";
+			reg = <0x0 0x0c265000 0x0 0x1ff>, /* TM */
+			      <0x0 0x0c223000 0x0 0x1ff>; /* SROT */
+			#qcom,sensors = <12>;
+			interrupts-extended = <&pdc 27 IRQ_TYPE_LEVEL_HIGH>,
+					      <&pdc 29 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "uplow", "critical";
+			#thermal-sensor-cells = <1>;
+		};
+
 		aoss_qmp: power-management@c300000 {
 			compatible = "qcom,sm7250-aoss-qmp", "qcom,aoss-qmp";
 			reg = <0x0 0x0c300000 0x0 0x1000>;
