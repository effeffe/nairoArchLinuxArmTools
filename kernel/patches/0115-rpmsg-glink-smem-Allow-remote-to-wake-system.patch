From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.com>
Date: Wed, 21 Oct 2026 19:38:54 +0100
Subject: [PATCH 115/159] rpmsg: glink: smem: Allow remote to wake system

The GLINK SMEM interrupt is requested with IRQF_NO_SUSPEND so the edge
keeps working while devices are suspended. A side effect is that the
IRQ is never armed for wakeup: suspend_device_irq() skips descriptors
with a non-zero no_suspend_depth before it looks at the wake setting.
During s2idle the CPU still leaves idle and runs the handler, but no
wakeup event is reported, so the system goes straight back to s2idle
with userspace frozen.

On SM7250 this means an incoming call or SMS never wakes the phone: the
modem delivers the QMI indication over GLINK, the kernel queues it on
the QRTR socket and ModemManager does not see it until something else
wakes the system.

Mark the edge device wakeup capable and report a hard wakeup event from
the interrupt handler with pm_wakeup_dev_event(). As with smp2p, wakeup
stays disabled by default and userspace enables it through power/wakeup
for the edges it wants, typically the modem.

Only report the event between the edge's suspend_noirq and resume_noirq
callbacks. ModemManager and other drivers still exchange messages with
the modem while the system is suspending (66 interrupts in one suspend
attempt on SM7250), and reporting those aborts every suspend with
-EBUSY.

The wakeup source device is a child of the edge device, and
qcom_glink_native_remove() unregisters every child of the edge.
Disable wakeup before calling it, otherwise device_del() of the edge
unregisters the wakeup source a second time and oopses in klist_put()
when the remote is stopped.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM
Signed-off-by: Filippo Falezza <filippo.falezza@outlook.com>
---
 drivers/rpmsg/qcom_glink_smem.c | 55 +++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/drivers/rpmsg/qcom_glink_smem.c b/drivers/rpmsg/qcom_glink_smem.c
index 35bb03e67ae8..04d78f159d2e 100644
--- a/drivers/rpmsg/qcom_glink_smem.c
+++ b/drivers/rpmsg/qcom_glink_smem.c
@@ -10,6 +10,7 @@
 #include <linux/of_irq.h>
 #include <linux/interrupt.h>
 #include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
 #include <linux/mailbox_client.h>
 #include <linux/mfd/syscon.h>
 #include <linux/slab.h>
@@ -45,6 +46,8 @@ struct qcom_glink_smem {
 	struct mbox_chan *mbox_chan;
 
 	u32 remote_pid;
+
+	bool suspended;
 };
 
 struct glink_smem_pipe {
@@ -212,11 +215,49 @@ static irqreturn_t qcom_glink_smem_intr(int irq, void *data)
 {
 	struct qcom_glink_smem *smem = data;
 
+	/*
+	 * The IRQ is IRQF_NO_SUSPEND, so it is never armed for wakeup and
+	 * cannot end s2idle by itself. Report a hard wakeup event instead,
+	 * but only once the edge is suspended: drivers and userspace still
+	 * talk to the remote while the system is going down, and that
+	 * traffic must not abort the suspend. This is a no-op unless
+	 * wakeup was enabled for the edge.
+	 */
+	if (READ_ONCE(smem->suspended))
+		pm_wakeup_dev_event(&smem->dev, 0, true);
+
 	qcom_glink_native_rx(smem->glink);
 
 	return IRQ_HANDLED;
 }
 
+static int qcom_glink_smem_suspend_noirq(struct device *dev)
+{
+	struct qcom_glink_smem *smem = container_of(dev, struct qcom_glink_smem, dev);
+
+	WRITE_ONCE(smem->suspended, true);
+
+	return 0;
+}
+
+static int qcom_glink_smem_resume_noirq(struct device *dev)
+{
+	struct qcom_glink_smem *smem = container_of(dev, struct qcom_glink_smem, dev);
+
+	WRITE_ONCE(smem->suspended, false);
+
+	return 0;
+}
+
+static const struct dev_pm_ops qcom_glink_smem_pm_ops = {
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(qcom_glink_smem_suspend_noirq,
+				  qcom_glink_smem_resume_noirq)
+};
+
+static const struct device_type qcom_glink_smem_type = {
+	.pm = &qcom_glink_smem_pm_ops,
+};
+
 static void qcom_glink_smem_release(struct device *dev)
 {
 	struct qcom_glink_smem *smem = container_of(dev, struct qcom_glink_smem, dev);
@@ -245,6 +286,7 @@ struct qcom_glink_smem *qcom_glink_smem_register(struct device *parent,
 
 	dev->parent = parent;
 	dev->of_node = node;
+	dev->type = &qcom_glink_smem_type;
 	dev->release = qcom_glink_smem_release;
 	dev_set_name(dev, "%s:%pOFn", dev_name(parent->parent), node);
 	ret = device_register(dev);
@@ -353,6 +395,13 @@ struct qcom_glink_smem *qcom_glink_smem_register(struct device *parent,
 
 	smem->glink = glink;
 
+	/*
+	 * Messages from the remote, e.g. an incoming call or SMS from the
+	 * modem, can wake the system, but keep it disabled by default so
+	 * userspace can enable it only for the edges it cares about.
+	 */
+	device_set_wakeup_capable(dev, true);
+
 	enable_irq(smem->irq);
 
 	return smem;
@@ -373,6 +422,12 @@ void qcom_glink_smem_unregister(struct qcom_glink_smem *smem)
 
 	disable_irq(smem->irq);
 
+	/*
+	 * Drop the wakeup source first: its device is a child of the edge,
+	 * and qcom_glink_native_remove() unregisters every child.
+	 */
+	device_init_wakeup(&smem->dev, false);
+
 	qcom_glink_native_remove(glink);
 
 	mbox_free_channel(smem->mbox_chan);
