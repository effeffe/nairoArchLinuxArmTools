From 9a03c3b735d0e4b407ff481647590d01a4a612e7 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Mon, 5 Oct 2026 15:02:06 +0100
Subject: [PATCH 35/69] soc: qcom: ubwc: Add SM7250

SM7250 uses UBWC 3.0 with highest bank bit 14, as in the downstream kgsl
device tree (qcom,ubwc-mode = 3, qcom,highest-bank-bit = 14).

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/soc/qcom/ubwc_config.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/soc/qcom/ubwc_config.c b/drivers/soc/qcom/ubwc_config.c
index a4d8769f8..456995699 100644
--- a/drivers/soc/qcom/ubwc_config.c
+++ b/drivers/soc/qcom/ubwc_config.c
@@ -42,6 +42,11 @@ static const struct qcom_ubwc_cfg_data ubwc_2_0_hbb15 = {
 	.highest_bank_bit = 15,
 };
 
+static const struct qcom_ubwc_cfg_data ubwc_3_0_hbb14 = {
+	.ubwc_enc_version = UBWC_3_0,
+	.highest_bank_bit = 14,
+};
+
 static const struct qcom_ubwc_cfg_data ubwc_3_0_hbb15 = {
 	.ubwc_enc_version = UBWC_3_0,
 	.highest_bank_bit = 15,
@@ -168,6 +173,7 @@ static const struct of_device_id qcom_ubwc_configs[] __maybe_unused = {
 	{ .compatible = "qcom,sm7125", .data = &ubwc_2_0_hbb14, },
 	{ .compatible = "qcom,sm7150", .data = &ubwc_2_0_hbb14, },
 	{ .compatible = "qcom,sm7225", .data = &ubwc_2_0_hbb14, },
+	{ .compatible = "qcom,sm7250", .data = &ubwc_3_0_hbb14, },
 	{ .compatible = "qcom,sm7325", .data = &ubwc_3_1_hbb14, },
 	{ .compatible = "qcom,sm8150", .data = &ubwc_3_0_hbb15, },
 	{ .compatible = "qcom,sm8250", .data = &ubwc_4_0_hbb16, },
