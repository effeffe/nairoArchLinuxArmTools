From 98c17ad18766b5f4557e9aedb3bc1c19fe60169d Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Sun, 4 Oct 2026 16:28:21 +0100
Subject: [PATCH 27/69] arm64: dts: qcom: sm7250: Add QUP1 SE1 SPI

Add the QUP1 SE1 SPI controller (SPI 354, pins GPIO 6-9 function qup11)
and the QUP1 wrapper's SMMU stream 0x23 from the downstream devicetree.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 arch/arm64/boot/dts/qcom/sm7250.dtsi | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7250.dtsi b/arch/arm64/boot/dts/qcom/sm7250.dtsi
index 02408f559..f47006444 100644
--- a/arch/arm64/boot/dts/qcom/sm7250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7250.dtsi
@@ -543,10 +543,24 @@ qupv3_id_1: geniqup@9c0000 {
 			clock-names = "m-ahb", "s-ahb";
 			clocks = <&gcc GCC_QUPV3_WRAP_1_M_AHB_CLK>,
 				 <&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
+			iommus = <&apps_smmu 0x23 0x0>;
 			#address-cells = <2>;
 			#size-cells = <2>;
 			ranges;
 
+			spi7: spi@984000 {
+				compatible = "qcom,geni-spi";
+				reg = <0x0 0x00984000 0x0 0x4000>;
+				clock-names = "se";
+				clocks = <&gcc GCC_QUPV3_WRAP1_S1_CLK>;
+				interrupts = <GIC_SPI 354 IRQ_TYPE_LEVEL_HIGH>;
+				pinctrl-0 = <&qup_spi7_default>;
+				pinctrl-names = "default";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+
 			uart2: serial@988000 {
 				compatible = "qcom,geni-debug-uart";
 				reg = <0 0x00988000 0 0x4000>;
@@ -952,6 +966,13 @@ data-pins {
 				};
 			};
 
+			qup_spi7_default: qup-spi7-default-state {
+				pins = "gpio6", "gpio7", "gpio8", "gpio9";
+				function = "qup11";
+				drive-strength = <6>;
+				bias-disable;
+			};
+
 			qup_uart2_default: qup-uart2-default-state {
 				pins = "gpio36", "gpio37";
 				function = "qup02";
-- 
