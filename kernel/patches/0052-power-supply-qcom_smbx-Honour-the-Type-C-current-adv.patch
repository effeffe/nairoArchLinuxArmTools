From e5ca0b053257946d6cc61a1ced6389f89979d732 Mon Sep 17 00:00:00 2001
From: Filippo Falezza <filippo.falezza@outlook.it>
Date: Mon, 5 Oct 2026 22:29:28 +0100
Subject: [PATCH 52/69] power: supply: qcom_smbx: Honour the Type-C current
 advertisement on SMB5

A Type-C source can advertise 1.5 A or 3 A on CC without any BC1.2
signalling, which APSD then reports as a standard downstream port, so
the input current limit stays at 500 mA. On SMB5, read the Type-C sink
status (charger base + 0x506, as in the downstream smb5 driver) and use
the advertised current when it is higher than the APSD result. Log the
chosen limit.

So far only tested on a PC port advertising default current, where the
limit correctly stays at 500 mA.

This patch was generated by an AI coding assistant (Claude Opus 5.5 in
Claude Code) during an interactive bring-up session on a Motorola Moto G
5G Plus (XT2075-3, "nairo"). It has not yet been reviewed line by line
by a human and needs that review before any submission.

Assisted-by: LLM dtschema
---
 drivers/power/supply/qcom_smbx.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index 3cf66a010..2e2c9632d 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -161,6 +161,13 @@ enum smb_generation {
 #define UFP_TYPEC_FMB_619K_BIT				BIT(1)
 #define UFP_TYPEC_OPEN_OPEN_BIT				BIT(0)
 
+/* SMB5: the Type-C block follows the charger, at base + 0x500 */
+#define SMB5_TYPE_C_SNK_STATUS				0x506
+#define SMB5_SNK_DAM_1500MA_BIT				BIT(5)
+#define SMB5_SNK_DAM_3000MA_BIT				BIT(4)
+#define SMB5_SNK_RP_1P5_BIT				BIT(2)
+#define SMB5_SNK_RP_3P0_BIT				BIT(1)
+
 #define TYPE_C_STATUS_2					0x30C
 #define DFP_RA_OPEN_BIT					BIT(7)
 #define TIMER_STAGE_BIT					BIT(6)
@@ -367,6 +374,8 @@ enum smb_generation {
 #define SDP_CURRENT_UA					500000
 #define CDP_CURRENT_UA					1500000
 #define DCP_CURRENT_UA					1500000
+#define TYPEC_1P5_CURRENT_UA				1500000
+#define TYPEC_3P0_CURRENT_UA				3000000
 #define CURRENT_MAX_UA					DCP_CURRENT_UA
 
 /* PMI8998 registers represent current in increments of 1/40th of an amp. */
@@ -716,6 +725,23 @@ static void smb_status_change_work(struct work_struct *work)
 		break;
 	}
 
+	/*
+	 * A Type-C source can advertise 1.5 A or 3 A on CC without any BC1.2
+	 * signalling, which APSD then reports as SDP: honour the advertisement.
+	 */
+	if (chip->gen == SMB5) {
+		unsigned int snk;
+
+		if (!regmap_read(chip->regmap, chip->base + SMB5_TYPE_C_SNK_STATUS, &snk)) {
+			if (snk & (SMB5_SNK_RP_3P0_BIT | SMB5_SNK_DAM_3000MA_BIT))
+				current_ua = max(current_ua, TYPEC_3P0_CURRENT_UA);
+			else if (snk & (SMB5_SNK_RP_1P5_BIT | SMB5_SNK_DAM_1500MA_BIT))
+				current_ua = max(current_ua, TYPEC_1P5_CURRENT_UA);
+			dev_dbg(chip->dev, "Type-C sink status %#x\n", snk);
+		}
+	}
+
+	dev_info(chip->dev, "input current limit %u uA\n", current_ua);
 	smb_set_current_limit(chip, current_ua);
 	power_supply_changed(chip->chg_psy);
 }
