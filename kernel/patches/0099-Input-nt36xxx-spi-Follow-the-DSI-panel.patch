Date: Sun, 11 Oct 2026 00:16:05 +0100
Subject: [PATCH 099/116] Input: nt36xxx-spi: Follow the DSI panel

The NT36672C is a touch and display chip: every panel power-up resets
the touch MCU. Register as a DRM panel follower, download the firmware
again once the panel is prepared and put the touch side to sleep before
the panel is unprepared, as the downstream driver does on its display
notifier.

These changes were written with the help of an LLM and checked by a human.

Assisted-by: LLM dtschema
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RmfiVDW3KWZdb9c3iDGRYg
---
 .../input/touchscreen/nt36xxx-spi/nt36xxx.c   | 37 +++++++++++++++++++
 .../input/touchscreen/nt36xxx-spi/nt36xxx.h   |  3 ++
 2 files changed, 40 insertions(+)

diff --git a/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.c b/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.c
index 121d425d4..c61f12dc0 100644
--- a/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.c
@@ -1243,6 +1243,31 @@ static void nvt_resume_work(struct work_struct *work)
 return:
 	Executive outcomes. 0---succeed. negative---failed
 *******************************************************/
+/*
+ * The NT36672C is a touch and display chip: every panel power-up (reset
+ * line and init sequence) resets the touch MCU too, so its firmware has to
+ * be downloaded again after the panel is on, and the touch side put to
+ * sleep before the panel goes off.
+ */
+static int nvt_panel_prepared(struct drm_panel_follower *follower)
+{
+	if (ts && ts->follower_ready)
+		nvt_ts_resume(&ts->client->dev);
+	return 0;
+}
+
+static int nvt_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	if (ts && ts->follower_ready)
+		nvt_ts_suspend(&ts->client->dev);
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs nvt_panel_follower_funcs = {
+	.panel_prepared = nvt_panel_prepared,
+	.panel_unpreparing = nvt_panel_unpreparing,
+};
+
 static int32_t nvt_ts_probe(struct spi_device *client)
 {
 	int32_t ret = 0;
@@ -1258,6 +1283,17 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 		return -ENOMEM;
 	}
 
+	/* Follow the panel this touch controller shares a chip with */
+	if (drm_is_panel_follower(&client->dev)) {
+		ts->panel_follower.funcs = &nvt_panel_follower_funcs;
+		ret = devm_drm_panel_add_follower(&client->dev, &ts->panel_follower);
+		if (ret) {
+			kfree(ts);
+			ts = NULL;
+			return dev_err_probe(&client->dev, ret, "failed to follow the panel\n");
+		}
+	}
+
 	ts->xbuf = (uint8_t *)kzalloc((NVT_TRANSFER_LEN+1+DUMMY_BYTES), GFP_KERNEL);
 	if(ts->xbuf == NULL) {
 		NVT_ERR("kzalloc for xbuf failed!\n");
@@ -1534,6 +1570,7 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 	NVT_LOG("end\n");
 
 	nvt_irq_enable(true);
+	ts->follower_ready = true;
 
 	return 0;
 
diff --git a/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.h b/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.h
index 1394c245d..861893b3a 100644
--- a/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.h
+++ b/drivers/input/touchscreen/nt36xxx-spi/nt36xxx.h
@@ -24,6 +24,7 @@
 #include <linux/of.h>
 #include <linux/gpio/consumer.h>
 #include <linux/spi/spi.h>
+#include <drm/drm_panel.h>
 #include <linux/uaccess.h>
 
 #include "nt36xxx_mem_map.h"
@@ -164,6 +165,8 @@ struct nvt_ts_data {
 	struct workqueue_struct *event_wq;
 	struct work_struct suspend_work;
 	struct work_struct resume_work;
+	struct drm_panel_follower panel_follower;
+	bool follower_ready;
 	int result_type;
 	int panel_index;
 	uint32_t spi_max_freq;
