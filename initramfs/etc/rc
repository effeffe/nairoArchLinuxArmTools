#!/bin/sh
# nairo bring-up userspace: USB gadget (NCM network + ACM serial), DHCP, dropbear.
# All output goes to the kernel log, so it reaches the fbcon and pstore.
# "rc gadget": only set up and bind the gadget (init then switches to the real
# root, whose systemd-networkd/sshd take over usb0).
exec >/dev/kmsg 2>&1
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
log() { echo "nairo-rc: $*"; }

/bin/busybox --install -s
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts

# the bootloader forces console=null: mirror the kernel log onto the fbcon
(cat /dev/kmsg | sed -e '/^ /d' -e 's/^[^;]*;//' > /dev/tty0 2>&1) &

i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; do
	i=$((i + 1))
	if [ $i -gt 20 ]; then
		log "no UDC after 20 s, giving up"
		exit 1
	fi
	sleep 1
done
UDC=$(ls /sys/class/udc | head -n 1)
log "UDC $UDC"

G=/sys/kernel/config/usb_gadget/nairo
if [ -d $G ]; then
	cd $G	# already set up by "rc gadget"
else
	mkdir $G && cd $G || exit 1
	echo 0x1d6b > idVendor		# Linux Foundation
	echo 0x0104 > idProduct		# Multifunction Composite Gadget
	mkdir strings/0x409
	echo nairo > strings/0x409/serialnumber
	echo Motorola > strings/0x409/manufacturer
	echo "Moto G 5G Plus (mainline)" > strings/0x409/product
	mkdir functions/ncm.usb0 functions/acm.GS0
	# fixed MACs (locally administered, derived from the serial number) so
	# the host sees the same adapter every boot and the phone keeps a stable
	# IPv6 link-local address
	H=$(sed -n 's/.*androidboot.serialno=\([^ ]*\).*/\1/p' /proc/cmdline | md5sum)
	echo "$H" | sed 's/^\(..\)\(..\)\(..\)\(..\)\(..\).*/02:\1:\2:\3:\4:\5/' > functions/ncm.usb0/dev_addr
	echo "$H" | sed 's/^..........\(..\)\(..\)\(..\)\(..\)\(..\).*/06:\1:\2:\3:\4:\5/' > functions/ncm.usb0/host_addr
	mkdir -p configs/c.1/strings/0x409
	echo "NCM + ACM" > configs/c.1/strings/0x409/configuration
	echo 500 > configs/c.1/MaxPower
	ln -s functions/ncm.usb0 configs/c.1/
	ln -s functions/acm.GS0 configs/c.1/
	if grep -q nairo.nobind /proc/cmdline; then
		log "nairo.nobind: not binding the gadget"
	else
		echo "$UDC" > UDC || log "binding the gadget to $UDC failed"
	fi
fi
IF=$(cat functions/ncm.usb0/ifname)
cd /

# Touch (NT36672C): load before switch_root, while its firmware is readable
# from the initramfs. Proven stable when loaded by hand; "nairo.notouch" on
# the kernel command line skips it.
if grep -qw nairo.notouch /proc/cmdline; then
	log "nairo.notouch: touch driver not loaded"
elif ! grep -q "^nt36xxx_spi " /proc/modules; then
	insmod /lib/modules/nt36xxx_spi.ko && log "touch driver loaded" ||
		log "touch driver failed to load"
fi

if [ "$1" = gadget ]; then
	log "gadget ready ($IF), handing over"
	exit 0
fi

ifconfig lo 127.0.0.1 up
ifconfig "$IF" 172.16.42.1 netmask 255.255.255.0 up
log "$IF up at 172.16.42.1"
udhcpd /etc/udhcpd.conf
mkdir -p /etc/dropbear
dropbear -R -p 22 && log "dropbear started"

# root shell on the USB serial port (/dev/ttyACM0 on the PC)
(while :; do setsid getty -n -l /bin/sh 115200 ttyGS0; sleep 1; done) &

# tell init to cancel its reboot timer once the PC has configured us
n=0
while [ "$(cat /sys/class/udc/$UDC/state)" != configured ]; do
	[ $((n % 10)) -eq 0 ] && log "udc state: $(cat /sys/class/udc/$UDC/state)"
	n=$((n + 1))
	sleep 1
done
log "gadget configured by host"
touch /run/nairo-stay
